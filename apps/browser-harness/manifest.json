{
  "manifest_version": 3,
  "name": "Seoul Harness",
  "version": "0.1.0",
  "description": "Milestone 4 vertical slice: a query goes in, element rects come out.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "src/background.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
