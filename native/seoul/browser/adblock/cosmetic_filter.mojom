// Project Seoul cosmetic filtering IPC. The browser derives the document URL
// from the bound RenderFrameHost; renderers never choose the filtering origin.

module seoul.adblock.mojom;

// A `:style()` rule the browser reduced to plain CSS: a selector and the
// declarations to apply to it. Separate from `selectors`, which are always
// hidden, because these change appearance rather than remove an element -
// typically restoring the scrolling a hidden consent modal left locked.
struct StyledSelector {
  string selector;
  string declarations;
};

struct CosmeticSelectorSet {
  array<string> selectors;
  array<StyledSelector> styled_selectors;
  string isolated_script;
  array<string> procedural_actions;
  bool query_generics;
};

struct CosmeticResources {
  bool enabled;
  CosmeticSelectorSet default_rules;
  CosmeticSelectorSet additional_rules;
};

struct DynamicCosmeticSelectors {
  array<string> default_selectors;
  array<string> additional_selectors;
};

interface CosmeticFilterHost {
  GetCosmeticResources() => (CosmeticResources resources);

  GetDynamicCosmeticSelectors(array<string> classes, array<string> ids) => (
      DynamicCosmeticSelectors selectors);

  // Farbled readbacks the document performed since its last report, by
  // surface: canvas pixels, WebGL pixels, the hardware profile. The browser
  // attributes them to the page from the bound frame; the renderer never
  // says which page it is.
  ReportFarbledReads(uint32 canvas, uint32 webgl, uint32 hardware);
};
