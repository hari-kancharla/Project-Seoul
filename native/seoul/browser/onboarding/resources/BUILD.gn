# Project Seoul first run - WebUI resources.
# Packages the welcome HTML/CSS and the TypeScript renderer into an in-process
# grit pack served by the WebUIDataSource under a strict CSP. No remote
# scripts, no eval, and no network of any kind from this surface.

import("//tools/typescript/ts_library.gni")
import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "seoul_welcome"

  static_files = [
    "seoul_icon.svg",
    "welcome.html",
  ]

  ts_files = [
    "welcome.html.ts",
    "welcome.ts",
    "welcome_marks.ts",
  ]

  css_files = [ "welcome.css" ]

  mojo_files_deps = [ "//seoul/browser/onboarding:mojo_bindings_ts__generator" ]
  mojo_files =
      [ "$root_gen_dir/seoul/browser/onboarding/welcome.mojom-webui.ts" ]

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  webui_context_type = "trusted"

  # Same position as the Canvas: build_ts still runs and gates real type errors.
  # The type-aware ESLint pass enforces Chromium WebUI authoring conventions
  # this surface was not written against; it is not a correctness gate.
  enable_type_aware_eslint_checks = false

  # Root the generated grit header under seoul/grit/, matching the include in
  # SeoulWelcomeUI.
  grit_output_dir = "$root_gen_dir/seoul"
}
