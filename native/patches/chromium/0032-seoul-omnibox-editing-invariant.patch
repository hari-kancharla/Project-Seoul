+bool BrowserView::IsSeoulOmniboxUserEditing() const {
+  if (!seoul_omnibox_floating_ || !toolbar_) {
+    return false;
+  }
+  LocationBarView* const location_bar = toolbar_->location_bar_view();
+  if (!location_bar || !location_bar->omnibox_view() ||
+      !location_bar->omnibox_view()->HasFocus()) {
+    return false;
+  }
+  // Action mode maintains its own empty query field and is dismissed through
+  // its own paths; only a real address/search edit is protected here.
+  if (seoul_omnibox_action_mode_) {
+    return false;
+  }
+  const OmniboxEditModel* const edit_model =
+      location_bar->GetOmniboxController()->edit_model();
+  return edit_model && edit_model->user_input_in_progress();
+}
