+enum class ContentCornerPlatform {
+  kMac,
+  kWindowsOrLinux,
+  kOther,
+};
+
+constexpr float ContentCornerRadiusForPlatform(
+    ContentCornerPlatform platform,
+    int macos_major_version) {
+  if (platform == ContentCornerPlatform::kMac) {
+    return macos_major_version >= 26 ? 10.0f : 6.0f;
+  }
+  return platform == ContentCornerPlatform::kWindowsOrLinux ? 5.0f : 6.0f;
+}
+
+static_assert(
+    ContentCornerRadiusForPlatform(ContentCornerPlatform::kMac, 26) == 10.0f);
+static_assert(
+    ContentCornerRadiusForPlatform(ContentCornerPlatform::kMac, 25) == 6.0f);
+static_assert(ContentCornerRadiusForPlatform(
+                  ContentCornerPlatform::kWindowsOrLinux, 0) == 5.0f);
+static_assert(
+    ContentCornerRadiusForPlatform(ContentCornerPlatform::kOther, 0) == 6.0f);
+
+float GetContentCornerRadius() {
+#if BUILDFLAG(IS_MAC)
+  return ContentCornerRadiusForPlatform(ContentCornerPlatform::kMac,
+                                        base::mac::MacOSMajorVersion());
+#elif BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+  return ContentCornerRadiusForPlatform(
+      ContentCornerPlatform::kWindowsOrLinux, 0);
+#else
+  return ContentCornerRadiusForPlatform(ContentCornerPlatform::kOther, 0);
+#endif
+}
