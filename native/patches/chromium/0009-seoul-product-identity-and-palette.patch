+void AddSeoulProductColorMixer(ui::ColorProvider* provider,
+                               const ui::ColorProviderKey& key) {
+  const bool dark_mode =
+      key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  const SkColor rail =
+      dark_mode ? SkColorSetRGB(0x29, 0x49, 0x37)
+                : SkColorSetRGB(0x5F, 0x8D, 0x6E);
+  const SkColor rail_inactive =
+      dark_mode ? SkColorSetRGB(0x32, 0x3F, 0x37)
+                : SkColorSetRGB(0x6E, 0x84, 0x75);
+  const SkColor selected =
+      dark_mode ? SkColorSetRGB(0x3F, 0x63, 0x4F)
+                : SkColorSetRGB(0x79, 0xA1, 0x86);
+  const SkColor hover =
+      dark_mode ? SkColorSetRGB(0x38, 0x58, 0x47)
+                : SkColorSetRGB(0x70, 0x99, 0x7D);
+  const SkColor foreground =
+      dark_mode ? SkColorSetRGB(0xF3, 0xF2, 0xEC)
+                : SkColorSetRGB(0xF8, 0xF7, 0xF1);
+  const SkColor foreground_muted =
+      dark_mode ? SkColorSetRGB(0xC4, 0xCE, 0xC5)
+                : SkColorSetRGB(0xE0, 0xE8, 0xE0);
+  const SkColor canvas =
+      dark_mode ? SkColorSetRGB(0x17, 0x17, 0x15)
+                : SkColorSetRGB(0xF2, 0xF1, 0xEB);
+  const SkColor canvas_text =
+      dark_mode ? SkColorSetRGB(0xF3, 0xF2, 0xEC)
+                : SkColorSetRGB(0x17, 0x17, 0x13);
+
+  ui::ColorMixer& mixer = provider->AddMixer();
+  mixer[ui::kColorFrameActive] = {rail};
+  mixer[ui::kColorFrameInactive] = {rail_inactive};
+  mixer[kColorToolbar] = {rail};
+  mixer[kColorToolbarBackgroundSubtleEmphasis] = {selected};
+  mixer[kColorToolbarBackgroundSubtleEmphasisHovered] = {hover};
+  mixer[kColorToolbarButtonIcon] = {foreground};
+  mixer[kColorToolbarButtonIconDefault] = {foreground};
+  mixer[kColorToolbarButtonIconHovered] = {foreground};
+  mixer[kColorToolbarButtonIconPressed] = {foreground};
+  mixer[kColorToolbarButtonText] = {foreground};
+  mixer[kColorToolbarText] = {foreground};
+  mixer[kColorToolbarTextDefault] = {foreground};
+  mixer[kColorLocationBarBackground] = {selected};
+  mixer[kColorLocationBarBackgroundHovered] = {hover};
+  mixer[kColorOmniboxText] = {foreground};
+  mixer[kColorOmniboxTextDimmed] = {foreground_muted};
+  mixer[kColorOmniboxActionIcon] = {foreground_muted};
+  mixer[kColorOmniboxResultsBackground] = {canvas};
+  mixer[kColorOmniboxResultsBackgroundHovered] = {
+      dark_mode ? SkColorSetRGB(0x28, 0x28, 0x24)
+                : SkColorSetRGB(0xE7, 0xE6, 0xDF)};
+  mixer[kColorOmniboxResultsBackgroundSelected] = {
+      dark_mode ? SkColorSetRGB(0x34, 0x40, 0x35)
+                : SkColorSetRGB(0xDF, 0xE7, 0xDB)};
+  mixer[kColorOmniboxResultsIcon] = {canvas_text};
+  mixer[kColorOmniboxResultsTextAnswer] = {canvas_text};
+  mixer[kColorOmniboxResultsTextDimmed] = {
+      dark_mode ? SkColorSetRGB(0xAE, 0xAD, 0xA5)
+                : SkColorSetRGB(0x67, 0x66, 0x60)};
+  mixer[kColorOmniboxResultsTextDimmedSelected] = {canvas_text};
+  mixer[kColorOmniboxResultsTextSecondary] = {
+      dark_mode ? SkColorSetRGB(0xAE, 0xAD, 0xA5)
+                : SkColorSetRGB(0x67, 0x66, 0x60)};
+  mixer[kColorOmniboxResultsTextSecondarySelected] = {canvas_text};
+  mixer[kColorOmniboxResultsTextSelected] = {canvas_text};
+  mixer[kColorOmniboxResultsUrl] = {selected};
+  mixer[kColorOmniboxResultsUrlSelected] = {selected};
+
+  mixer[kColorTabBackgroundActiveFrameActive] = {selected};
+  mixer[kColorTabBackgroundActiveFrameInactive] = {selected};
+  mixer[kColorTabBackgroundInactiveFrameActive] = {rail};
+  mixer[kColorTabBackgroundInactiveFrameInactive] = {rail_inactive};
+  mixer[kColorTabBackgroundInactiveHoverFrameActive] = {hover};
+  mixer[kColorTabBackgroundInactiveHoverFrameInactive] = {hover};
+  mixer[kColorTabBackgroundSelectedFrameActive] = {selected};
+  mixer[kColorTabBackgroundSelectedFrameInactive] = {selected};
+  mixer[kColorTabBackgroundSelectedHoverFrameActive] = {hover};
+  mixer[kColorTabBackgroundSelectedHoverFrameInactive] = {hover};
+  mixer[kColorTabForegroundActiveFrameActive] = {foreground};
+  mixer[kColorTabForegroundActiveFrameInactive] = {foreground_muted};
+  mixer[kColorTabForegroundInactiveFrameActive] = {foreground};
+  mixer[kColorTabForegroundInactiveFrameInactive] = {foreground_muted};
+  mixer[kColorTabDividerFrameActive] = {rail};
+  mixer[kColorTabDividerFrameInactive] = {rail_inactive};
+  mixer[kColorVerticalTabPinnedOutline] = {hover};
+  mixer[kColorVerticalTabStripShadow] = {
+      SkColorSetA(SK_ColorBLACK, dark_mode ? 0x66 : 0x38)};
+  mixer[kColorNewTabButtonCRForegroundFrameActive] = {foreground};
+  mixer[kColorNewTabButtonCRForegroundFrameInactive] = {foreground_muted};
+  mixer[kColorNewTabButtonCRBackgroundFrameActive] = {rail};
+  mixer[kColorNewTabButtonCRBackgroundFrameInactive] = {rail_inactive};
+  mixer[kColorTabSearchButtonCRForegroundFrameActive] = {foreground};
+  mixer[kColorTabSearchButtonCRForegroundFrameInactive] = {foreground_muted};
+
+  mixer[kColorNewTabPageBackground] = {canvas};
+  mixer[kColorNewTabPageBackgroundOverride] = {canvas};
+  mixer[kColorNewTabPagePrimaryForeground] = {canvas_text};
+  mixer[kColorNewTabPageSecondaryForeground] = {
+      dark_mode ? SkColorSetRGB(0xAE, 0xAD, 0xA5)
+                : SkColorSetRGB(0x67, 0x66, 0x60)};
+}
