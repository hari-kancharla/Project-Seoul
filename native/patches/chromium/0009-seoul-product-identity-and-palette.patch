+/*
+ * Seoul opens new tabs through the native command surface. A second Google
+ * search product inside the page duplicates the omnibox and is the largest
+ * remaining Chromium identity leak, so the fallback document is intentionally
+ * a calm, empty canvas. Browser commands, history, search, and URL entry remain
+ * available from the native floating bar.
+ */
+#oneGoogleBarStackingContext,
+#oneGoogleBar,
+#oneGoogleBarScrim,
+#logo,
+#searchboxContainer,
+ntp-action-chips,
+cr-most-visited,
+ntp-middle-slot-promo,
+#modules,
+#webstoreToast,
+#undoToast,
+individual-promos,
+#backgroundImageAttribution,
+#customizeButtons,
+#themeAttribution,
+#contentBottomSpacer,
+svg {
+  display: none !important;
+}
+
+:host #content {
+  background:
+    radial-gradient(
+      circle at 72% -12%,
+      color-mix(in srgb, var(--color-new-tab-page-primary-foreground) 5%, transparent),
+      transparent 38%
+    ),
+    var(--color-new-tab-page-background);
+  height: 100vh;
+  min-width: 0;
+  padding: 0;
+}
