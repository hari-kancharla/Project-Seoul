+void ToolbarView::SetSeoulSidebarPresentation(bool collapsed) {
+  if (display_mode_ != DisplayMode::kNormal) {
+    return;
+  }
+  seoul_sidebar_mode_ = true;
+  seoul_sidebar_collapsed_ = collapsed;
+  if (initialized_) {
+    ApplySeoulSidebarPresentation();
+  } else {
+    SetVisible(!collapsed);
+  }
+  InvalidateLayout();
+  PreferredSizeChanged();
+}
+
+void ToolbarView::ApplySeoulSidebarPresentation() {
+  if (!seoul_sidebar_mode_ || display_mode_ != DisplayMode::kNormal) {
+    return;
+  }
+  SetVisible(!seoul_sidebar_collapsed_);
+  if (seoul_sidebar_collapsed_ || !initialized_) {
+    return;
+  }
+
+  // Keep core navigation beside the address field. Secondary browser actions
+  // remain available from Commands/More instead of crowding the narrow rail.
+  for (views::View* child : children()) {
+    const bool should_show =
+        child == back_ || child == forward_ || child == reload_ ||
+        child == location_bar_view_ || child == toolbar_webview_;
+    if (child->GetVisible() != should_show) {
+      child->SetVisible(should_show);
+    }
+  }
+  if (overflow_button_) {
+    overflow_button_->SetVisible(false);
+  }
+  if (layout_manager_) {
+    // Tight interior margins; outer traffic-light clearance lives on the
+    // toolbar's region-view margin in BrowserView.
+    layout_manager_->SetInteriorMargin(gfx::Insets::TLBR(0, 2, 0, 2));
+  }
+  // Page-action chips (AI Mode and friends) steal omnibox width in the rail.
+  if (location_bar_view_) {
+    if (auto* page_actions = location_bar_view_->page_action_container()) {
+      page_actions->SetVisible(false);
+    }
+  }
+}
