 #include "base/test/gtest_util.h"
 #include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/color/chrome_color_mixers.h"
 #include "testing/gtest/include/gtest/gtest.h"
 #include "ui/color/color_id.h"
+#include "ui/color/color_mixers.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/gfx/color_utils.h"
 
 using ChromeColorProviderUtilsTest = ::testing::Test;
 
@@ -15,3 +20,38 @@ TEST_F(ChromeColorProviderUtilsTest, ChromeColorIdNameTest) {
   EXPECT_EQ("kColorToolbarBackgroundSubtleEmphasis",
             ChromeColorIdName(kColorToolbarBackgroundSubtleEmphasis));
 }
+
+TEST_F(ChromeColorProviderUtilsTest,
+       SeoulStateLayersPreserveMaterialAndReadableText) {
+  for (const bool dark_mode : {false, true}) {
+    ui::ColorProvider provider;
+    ui::ColorProviderKey key;
+    if (dark_mode) {
+      key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
+    }
+    AddColorMixers(&provider, key);
+    AddChromeColorMixers(&provider, key);
+
+    const SkColor frame = provider.GetColor(ui::kColorFrameActive);
+    const SkColor active =
+        provider.GetColor(kColorToolbarBackgroundSubtleEmphasis);
+    const SkColor hover =
+        provider.GetColor(kColorToolbarBackgroundSubtleEmphasisHovered);
+    const SkColor selected_tab =
+        provider.GetColor(kColorTabBackgroundActiveFrameActive);
+
+    // These shared tokens are used as contrast-recipe backgrounds, so their
+    // Zen alpha layers must already be composited and opaque.
+    EXPECT_EQ(SK_AlphaOPAQUE, SkColorGetA(active));
+    EXPECT_EQ(SK_AlphaOPAQUE, SkColorGetA(hover));
+    EXPECT_EQ(SK_AlphaOPAQUE, SkColorGetA(selected_tab));
+    EXPECT_GE(color_utils::GetContrastRatio(
+                  provider.GetColor(kColorToolbarText), frame),
+              color_utils::kMinimumReadableContrastRatio);
+    EXPECT_GE(
+        color_utils::GetContrastRatio(
+            provider.GetColor(kColorTabForegroundActiveFrameActive),
+            color_utils::GetResultingPaintColor(selected_tab, frame)),
+        color_utils::kMinimumReadableContrastRatio);
+  }
+}
