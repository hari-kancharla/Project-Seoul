@@ -0,0 +1,13 @@
+// Copyright 2026 The Project Seoul Authors
+#ifndef CONTENT_PUBLIC_BROWSER_SESSION_STORAGE_NAMESPACE_UTILS_H_
+#define CONTENT_PUBLIC_BROWSER_SESSION_STORAGE_NAMESPACE_UTILS_H_
+#include "content/common/content_export.h"
+namespace content {
+class SessionStorageNamespace;
+class WebContents;
+// The controller retains this namespace. Select the primary page's actual
+// partition, so container tabs do not save or restore the default session.
+CONTENT_EXPORT SessionStorageNamespace* SessionStorageForWebContents(
+    WebContents* contents);
+}  // namespace content
+#endif
