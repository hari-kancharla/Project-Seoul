diff --git a/third_party/blink/common/privacy/seoul_farbling.cc b/third_party/blink/common/privacy/seoul_farbling.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/common/privacy/seoul_farbling.cc
@@ -0,0 +1,86 @@
+// Project Seoul farbling - the generator every farbled surface draws from.
+
+#include "third_party/blink/public/common/privacy/seoul_farbling.h"
+
+namespace blink {
+
+namespace {
+
+// SplitMix64's finalizer: a strong avalanche in a handful of instructions,
+// which matters because this runs once per pixel of a readback.
+uint64_t Mix64(uint64_t z) {
+  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+  z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+  return z ^ (z >> 31);
+}
+
+}  // namespace
+
+uint64_t SeoulFarblingSeed(uint64_t token, SeoulFarblingSurface surface) {
+  // The whole token participates. Shifting a 32-bit value up and xoring it
+  // back, as this did while the token was narrow, would discard the upper half
+  // of a 64-bit one and leave the keyspace exactly as searchable as before.
+  return Mix64(token +
+               static_cast<uint64_t>(surface) * 0x9E3779B97F4A7C15ull);
+}
+
+uint64_t SeoulFarblingPixelHash(uint64_t seed, int32_t x, int32_t y) {
+  return Mix64(seed +
+               static_cast<uint64_t>(static_cast<uint32_t>(x)) *
+                   0x9E3779B97F4A7C15ull +
+               static_cast<uint64_t>(static_cast<uint32_t>(y)) *
+                   0xC2B2AE3D27D4EB4Full);
+}
+
+SeoulFarblingGenerator::SeoulFarblingGenerator(uint64_t token,
+                                               SeoulFarblingSurface surface)
+    : state_((static_cast<uint64_t>(token) << 32) ^
+             (static_cast<uint64_t>(surface) * 0x9E3779B97F4A7C15ull) ^
+             token) {}
+
+uint64_t SeoulFarblingGenerator::Next() {
+  state_ += 0x9E3779B97F4A7C15ull;
+  uint64_t z = state_;
+  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+  z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+  return z ^ (z >> 31);
+}
+
+uint64_t SeoulFarblingGenerator::NextInRange(uint64_t low, uint64_t high) {
+  if (high <= low) {
+    return low;
+  }
+  return low + Next() % (high - low + 1);
+}
+
+unsigned SeoulFarbleHardwareConcurrency(unsigned real_count, uint64_t token) {
+  constexpr unsigned kFloor = 4;
+  if (token == 0 || real_count < kFloor) {
+    return real_count;
+  }
+  SeoulFarblingGenerator generator(token,
+                                   SeoulFarblingSurface::kHardwareConcurrency);
+  return static_cast<unsigned>(generator.NextInRange(kFloor, real_count));
+}
+
+float SeoulFarbleDeviceMemory(float real_gib, uint64_t token) {
+  constexpr float kFloor = 4.0f;
+  if (token == 0 || !(real_gib >= kFloor)) {
+    return real_gib;
+  }
+  // Blink reports powers of two (0.25 ... 8), so the candidates between the
+  // floor and the real bucket are the doublings of the floor that fit.
+  unsigned doublings = 0;
+  for (float bucket = kFloor; bucket * 2.0f <= real_gib; bucket *= 2.0f) {
+    ++doublings;
+  }
+  SeoulFarblingGenerator generator(token, SeoulFarblingSurface::kDeviceMemory);
+  const uint64_t chosen = generator.NextInRange(0, doublings);
+  float value = kFloor;
+  for (uint64_t i = 0; i < chosen; ++i) {
+    value *= 2.0f;
+  }
+  return value;
+}
+
+}  // namespace blink
