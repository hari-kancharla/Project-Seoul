new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/core/html/canvas/seoul_canvas_farbling.cc
@@ -0,0 +1,249 @@
+// Project Seoul canvas farbling.
+
+#include "third_party/blink/renderer/core/html/canvas/seoul_canvas_farbling.h"
+
+#include <utility>
+
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace blink {
+
+namespace {
+
+bool IsFarblablePixelWidth(int bytes_per_pixel) {
+  return bytes_per_pixel == 4 || bytes_per_pixel == 8 || bytes_per_pixel == 16;
+}
+
+// Perturbs one readback in place.
+//
+// The perturbation of a pixel is a pure function of the site's token and that
+// pixel's ABSOLUTE coordinate on the canvas - never of where the pixel happens
+// to sit inside this particular readback. That is the whole correctness
+// requirement, and it is worth stating why.
+//
+// An earlier design drew a bounded pseudo-random set of positions inside the
+// buffer being returned. It is invisible and it is deterministic, and it is
+// also useless: `getImageData(0, 0, w, h)` and `getImageData(10, 10, 8, 8)`
+// then perturb the same screen pixel differently, so a script detects the
+// protection by reading one region twice at different offsets, and - far worse
+// - recovers the true canvas exactly by reading it many times and taking the
+// per-pixel majority, because each read disturbs a different sparse set. A
+// fingerprint that survives the defence is not a defence.
+//
+// Keyed on the absolute coordinate, every readback of a pixel returns the same
+// perturbed value: whole canvas or sub-rectangle, `getImageData` or
+// `toDataURL` or `readPixels`. Repetition reveals nothing, and the site's hash
+// is stable for the session (so the page's own caching still works) while
+// differing from every other site's.
+//
+// `origin` is the readback's top-left corner in canvas space. `flip_height`,
+// when non-zero, converts a bottom-left origin (WebGL) into the same top-left
+// space everything else uses, so the two APIs cannot disagree about a pixel.
+//
+// Cost is now proportional to the pixels actually returned rather than
+// constant. That is the price of the property above; a small `getImageData`
+// stays small, and a full-canvas read is dominated by its own copy and encode.
+void FarbleRows(base::span<uint8_t> bytes,
+                int origin_x,
+                int origin_y,
+                int width,
+                int height,
+                size_t row_bytes,
+                size_t channel_bytes,
+                int flip_height,
+                uint64_t seed) {
+  if (bytes.empty() || width <= 0 || height <= 0 || channel_bytes == 0) {
+    return;
+  }
+  const size_t pixel_bytes = 4u * channel_bytes;
+  for (int row = 0; row < height; ++row) {
+    const int absolute_y = flip_height > 0
+                               ? flip_height - 1 - (origin_y + row)
+                               : origin_y + row;
+    const size_t row_start = static_cast<size_t>(row) * row_bytes;
+    for (int column = 0; column < width; ++column) {
+      const uint64_t h = SeoulFarblingPixelHash(seed, origin_x + column,
+                                                absolute_y);
+      // A quarter of pixels are left exactly as drawn and the rest move by at
+      // most 3 of 255 in a single colour channel - beneath perception, above
+      // the rounding of a fingerprinter that averages or quantises. Never
+      // alpha: a changed alpha is visible where a colour bit is not.
+      const uint8_t mask = static_cast<uint8_t>(h & 0x3u);
+      if (mask == 0) {
+        continue;
+      }
+      const size_t pixel_start =
+          row_start + static_cast<size_t>(column) * pixel_bytes;
+      // A fully transparent pixel has no colour to hide, and a blank or
+      // out-of-bounds region that read back non-zero would both announce the
+      // protection and break code that checks a canvas is empty. Every format
+      // reaches here as 8-bit, so this guard covers all of them.
+      const size_t alpha = pixel_start + 3u;
+      if (alpha >= bytes.size() || bytes[alpha] == 0u) {
+        continue;
+      }
+      const size_t channel = static_cast<size_t>((h >> 2) % 3u);
+      const size_t offset = pixel_start + channel * channel_bytes;
+      if (offset < bytes.size()) {
+        bytes[offset] ^= mask;
+      }
+    }
+  }
+}
+
+}  // namespace
+
+void SeoulFarblePixels(const SkPixmap& pixmap,
+                       int origin_x,
+                       int origin_y,
+                       int flip_height,
+                       uint64_t token) {
+  if (token == 0 || !pixmap.addr()) {
+    return;
+  }
+  const int bytes_per_pixel = pixmap.info().bytesPerPixel();
+  if (!IsFarblablePixelWidth(bytes_per_pixel)) {
+    return;
+  }
+  const uint64_t seed =
+      SeoulFarblingSeed(token, SeoulFarblingSurface::kCanvasPixels);
+
+  // A wide-channel readback cannot be perturbed in its own storage. Flipping
+  // the low bits of a 32-bit float moves the value by roughly a
+  // twenty-thousandth of an 8-bit step, so Math.round(data[i] * 255) recovers
+  // the true colour of every pixel exactly: a page asks for `rgba-float32` and
+  // the protection evaporates. Quantising first means a float read and an
+  // ordinary read of the same pixel agree, so the two cannot be differenced
+  // either. The cost is that a farbled float readback returns 8-bit precision,
+  // which is the honest trade - that extra precision is itself a
+  // fingerprinting surface, and it is only spent on readbacks already being
+  // perturbed.
+  if (bytes_per_pixel != 4) {
+    const SkImageInfo info8 =
+        pixmap.info().makeColorType(kRGBA_8888_SkColorType);
+    SkBitmap staging;
+    if (!staging.tryAllocPixels(info8) ||
+        !pixmap.readPixels(staging.pixmap())) {
+      return;
+    }
+    const SkPixmap staged = staging.pixmap();
+    // SAFETY: computeByteSize() is the byte length of the pixel memory that
+    // writable_addr() addresses, by SkPixmap's own contract.
+    base::span<uint8_t> staged_bytes = UNSAFE_BUFFERS(base::span<uint8_t>(
+        static_cast<uint8_t*>(staged.writable_addr()),
+        staged.computeByteSize()));
+    FarbleRows(staged_bytes, origin_x, origin_y, staged.width(),
+               staged.height(), staged.rowBytes(), /*channel_bytes=*/1u,
+               flip_height, seed);
+    SkBitmap destination;
+    if (destination.installPixels(pixmap.info(), pixmap.writable_addr(),
+                                  pixmap.rowBytes())) {
+      destination.writePixels(staged, 0, 0);
+    }
+    return;
+  }
+
+  // SAFETY: computeByteSize() is the byte length of the pixel memory that
+  // writable_addr() addresses, by SkPixmap's own contract.
+  base::span<uint8_t> bytes = UNSAFE_BUFFERS(base::span<uint8_t>(
+      static_cast<uint8_t*>(pixmap.writable_addr()), pixmap.computeByteSize()));
+  FarbleRows(bytes, origin_x, origin_y, pixmap.width(), pixmap.height(),
+             pixmap.rowBytes(), /*channel_bytes=*/1u, flip_height, seed);
+}
+
+void SeoulFarbleCanvasReadback(const SkPixmap& pixmap,
+                               int origin_x,
+                               int origin_y,
+                               ExecutionContext* context) {
+  const uint64_t token = SeoulFarblingTokenFor(context);
+  if (token == 0 || !pixmap.addr() ||
+      !IsFarblablePixelWidth(pixmap.info().bytesPerPixel())) {
+    return;
+  }
+  SeoulFarblePixels(pixmap, origin_x, origin_y, /*flip_height=*/0, token);
+  SeoulReportFarbled(context, SeoulFarblingSurface::kCanvasPixels);
+}
+
+void SeoulFarbleWebGLReadback(base::span<uint8_t> pixels,
+                              int origin_x,
+                              int origin_y,
+                              int width,
+                              int height,
+                              size_t row_bytes,
+                              int drawing_buffer_height,
+                              ExecutionContext* context) {
+  const uint64_t token = SeoulFarblingTokenFor(context);
+  if (token == 0 || pixels.empty() || width <= 0 || height <= 0) {
+    return;
+  }
+  // WebGL reads from a bottom-left origin; `drawing_buffer_height` puts those
+  // rows back into the top-left space the 2D readbacks use, so a script cannot
+  // learn anything by comparing readPixels against toDataURL of the same
+  // canvas.
+  FarbleRows(pixels, origin_x, origin_y, width, height, row_bytes,
+             /*channel_bytes=*/1u, drawing_buffer_height,
+             SeoulFarblingSeed(token, SeoulFarblingSurface::kCanvasPixels));
+  SeoulReportFarbled(context, SeoulFarblingSurface::kWebGLPixels);
+}
+
+scoped_refptr<StaticBitmapImage> SeoulMaybeFarbleForReadback(
+    scoped_refptr<StaticBitmapImage> image,
+    ExecutionContext* context) {
+  const uint64_t token = SeoulFarblingTokenFor(context);
+  if (token == 0 || !image) {
+    return image;
+  }
+  // A GPU-backed snapshot is read back to the CPU first; the encoders would
+  // do the same, so this only moves that work earlier.
+  scoped_refptr<StaticBitmapImage> source = image->MakeUnaccelerated();
+  if (!source) {
+    return image;
+  }
+  const PaintImage paint_image = source->PaintImageForCurrentFrame();
+  if (!paint_image || paint_image.width() <= 0 || paint_image.height() <= 0) {
+    return image;
+  }
+  // The copy keeps the source's colour type and colour space, so an 8-bit
+  // canvas still encodes as 8-bit and a float16 one as float16, exactly as
+  // it would unfarbled. Only the alpha type moves: an opaque image stays
+  // opaque; anything else is read back unpremultiplied, so a perturbed colour
+  // bit is always a valid pixel and the encoders (which want unpremultiplied
+  // bytes) convert nothing away.
+  const SkImageInfo source_info = paint_image.GetSkImageInfo();
+  const SkImageInfo info = source_info.makeAlphaType(
+      source_info.isOpaque() ? kOpaque_SkAlphaType : kUnpremul_SkAlphaType);
+  if (!IsFarblablePixelWidth(info.bytesPerPixel())) {
+    return image;
+  }
+  SkBitmap copy;
+  if (!copy.tryAllocPixels(info)) {
+    return image;
+  }
+  if (!paint_image.readPixels(info, copy.getPixels(), copy.rowBytes(), 0, 0)) {
+    return image;
+  }
+  SkPixmap pixmap;
+  if (!copy.peekPixels(&pixmap)) {
+    return image;
+  }
+  // The encoders always receive the whole canvas, so this readback's origin is
+  // the canvas origin.
+  SeoulFarblePixels(pixmap, /*origin_x=*/0, /*origin_y=*/0, /*flip_height=*/0,
+                    token);
+  copy.setImmutable();
+  sk_sp<SkImage> farbled = SkImages::RasterFromBitmap(copy);
+  if (!farbled) {
+    return image;
+  }
+  SeoulReportFarbled(context, SeoulFarblingSurface::kCanvasPixels);
+  return UnacceleratedStaticBitmapImage::Create(std::move(farbled));
+}
+
+}  // namespace blink
