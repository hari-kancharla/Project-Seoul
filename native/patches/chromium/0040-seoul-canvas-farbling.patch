diff --git a/third_party/blink/public/common/privacy/seoul_farbling.h b/third_party/blink/public/common/privacy/seoul_farbling.h
new file mode 100644
--- /dev/null
+++ b/third_party/blink/public/common/privacy/seoul_farbling.h
@@ -0,0 +1,75 @@
+// Project Seoul farbling - the generator every farbled surface draws from.
+//
+// Shared between the renderer and the browser on purpose. Blink derives what
+// a site is told from a per-site session token; the browser derives the same
+// answers from the same token to show a person exactly what the site was
+// told. One implementation, so the two can never drift.
+//
+// Everything here is a pure function of the token. Within a session the same
+// site always sees the same answers (reading twice proves nothing, legitimate
+// round-trips stay stable); other sites and later sessions see different ones
+// (a hash of the answers links nothing across sites). A token of 0 means the
+// surface is left exactly as upstream computes it.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_PRIVACY_SEOUL_FARBLING_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_PRIVACY_SEOUL_FARBLING_H_
+
+#include <stdint.h>
+
+#include "third_party/blink/public/common/common_export.h"
+
+namespace blink {
+
+// Which surface a value is being farbled for. Each surface seeds its own
+// generator, so the canvas noise pattern and the hardware profile are
+// independent draws from one secret rather than one shared sequence.
+enum class SeoulFarblingSurface : uint32_t {
+  kCanvasPixels = 1,
+  kWebGLPixels = 2,
+  kHardwareConcurrency = 3,
+  kDeviceMemory = 4,
+};
+
+// Deterministic 64-bit generator (SplitMix64) seeded from a token and a
+// surface. Small, fast, and statistically fine for choosing which low bits to
+// flip or which plausible value to report. It is not cryptographic and does
+// not need to be: the secret is the per-session token, not the generator.
+class BLINK_COMMON_EXPORT SeoulFarblingGenerator {
+ public:
+  SeoulFarblingGenerator(uint64_t token, SeoulFarblingSurface surface);
+
+  uint64_t Next();
+  // A value in [low, high]; `low` when the range is empty.
+  uint64_t NextInRange(uint64_t low, uint64_t high);
+
+ private:
+  uint64_t state_;
+};
+
+// navigator.hardwareConcurrency as a fingerprinter should see it: the real
+// count on machines below four cores (already generic, and lying downward only
+// breaks scheduling heuristics), otherwise a stable per-site value between
+// four and the real count. Brave's model.
+BLINK_COMMON_EXPORT unsigned SeoulFarbleHardwareConcurrency(unsigned real_count,
+                                                            uint64_t token);
+
+// navigator.deviceMemory as a fingerprinter should see it: the real bucket
+// below 4 GiB, otherwise a stable per-site bucket between 4 GiB and the real
+// one, on the specification's own power-of-two scale.
+BLINK_COMMON_EXPORT float SeoulFarbleDeviceMemory(float real_gib, uint64_t token);
+
+// The seed a surface draws from, for perturbations that must be a pure
+// function of a coordinate rather than of a sequence: a readback cannot depend
+// on the order its pixels are visited, or two readbacks of one pixel disagree.
+BLINK_COMMON_EXPORT uint64_t SeoulFarblingSeed(uint64_t token,
+                                               SeoulFarblingSurface surface);
+
+// A well-mixed value for one pixel, keyed on its absolute coordinate, so every
+// readback covering that pixel agrees about it however it was framed.
+BLINK_COMMON_EXPORT uint64_t SeoulFarblingPixelHash(uint64_t seed,
+                                                    int32_t x,
+                                                    int32_t y);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_PRIVACY_SEOUL_FARBLING_H_
