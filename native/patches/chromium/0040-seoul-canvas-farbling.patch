new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/core/frame/seoul_farbling.cc
@@ -0,0 +1,57 @@
+// Project Seoul farbling - the renderer's side.
+
+#include "third_party/blink/renderer/core/frame/seoul_farbling.h"
+
+#include "third_party/blink/public/common/loader/loading_behavior_flag.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/frame/settings.h"
+#include "third_party/blink/renderer/core/loader/document_loader.h"
+#include "third_party/blink/renderer/core/loader/frame_loader.h"
+#include "third_party/blink/renderer/core/workers/worker_global_scope.h"
+#include "third_party/blink/renderer/core/workers/worker_settings.h"
+
+namespace blink {
+
+uint64_t SeoulFarblingTokenFor(ExecutionContext* context) {
+  if (!context) {
+    return 0;
+  }
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    LocalFrame* frame = window->GetFrame();
+    const Settings* settings = frame ? frame->GetSettings() : nullptr;
+    return settings ? settings->GetSeoulFarblingToken() : 0;
+  }
+  if (auto* scope = DynamicTo<WorkerGlobalScope>(context)) {
+    const WorkerSettings* settings = scope->GetWorkerSettings();
+    return settings ? settings->SeoulFarblingToken() : 0;
+  }
+  return 0;
+}
+
+void SeoulReportFarbled(ExecutionContext* context,
+                        SeoulFarblingSurface surface) {
+  auto* window = DynamicTo<LocalDOMWindow>(context);
+  LocalFrame* frame = window ? window->GetFrame() : nullptr;
+  DocumentLoader* loader = frame ? frame->Loader().GetDocumentLoader() : nullptr;
+  if (!loader) {
+    return;
+  }
+  LoadingBehaviorFlag flag = kLoadingBehaviorNone;
+  switch (surface) {
+    case SeoulFarblingSurface::kCanvasPixels:
+      flag = kLoadingBehaviorSeoulFarbledCanvasReadback;
+      break;
+    case SeoulFarblingSurface::kWebGLPixels:
+      flag = kLoadingBehaviorSeoulFarbledWebGLReadback;
+      break;
+    case SeoulFarblingSurface::kHardwareConcurrency:
+    case SeoulFarblingSurface::kDeviceMemory:
+      flag = kLoadingBehaviorSeoulFarbledHardwareProfile;
+      break;
+  }
+  loader->DidObserveLoadingBehavior(flag);
+}
+
+}  // namespace blink
diff --git a/third_party/blink/renderer/core/frame/seoul_farbling.h b/third_party/blink/renderer/core/frame/seoul_farbling.h
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/core/frame/seoul_farbling.h
@@ -0,0 +1,40 @@
+// Project Seoul farbling - the renderer's side: which token applies to an
+// execution context, and the receipt of every farbled answer.
+//
+// The browser decides, per site and per session, whether a page's readbacks
+// and hardware profile are perturbed, and hands the renderer a 32-bit token
+// through WebPreferences. The generator that turns the token into answers
+// lives in public/common/privacy/seoul_farbling.h, shared with the browser.
+//
+// Window contexts read the token from the page's Settings. Dedicated workers
+// and worklets read the copy WorkerSettings takes at creation, the same way
+// they inherit disable_reading_from_canvas. Shared and service workers have no
+// creating page and carry no token.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_SEOUL_FARBLING_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_SEOUL_FARBLING_H_
+
+#include <stdint.h>
+
+#include "third_party/blink/public/common/privacy/seoul_farbling.h"
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace blink {
+
+class ExecutionContext;
+
+// The farbling token for `context`, or 0 when farbling is off for it: no
+// context, a context without a page or worker settings, or a site the
+// browser left alone.
+CORE_EXPORT uint64_t SeoulFarblingTokenFor(ExecutionContext* context);
+
+// Records that a script in `context` just received a farbled answer for
+// `surface`, as a loading behaviour the frame's embedder observes and counts
+// for the page's receipt. Window contexts only: a worker has no document
+// loader, so its readbacks are farbled but go unreceipted.
+CORE_EXPORT void SeoulReportFarbled(ExecutionContext* context,
+                                    SeoulFarblingSurface surface);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_SEOUL_FARBLING_H_
