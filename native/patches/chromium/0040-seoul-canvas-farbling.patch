+// Project Seoul canvas farbling.
+//
+// Perturbs the pixels a script reads back, keyed by the per-site session token
+// from core/frame/seoul_farbling.h. The perturbation of a pixel is a pure
+// function of that pixel's ABSOLUTE coordinate on the canvas, so every readback
+// of the same pixel agrees - whole canvas or sub-rectangle, getImageData or
+// toDataURL or WebGL readPixels. Reading a region repeatedly therefore reveals
+// nothing, which is the property that makes the canvas useless as a cross-site
+// identifier; a design keyed on position-within-this-readback would instead let
+// a script average the true image back out.
+//
+// A quarter of pixels are returned exactly as drawn and the rest move by at
+// most 3 of 255 in one colour channel, never alpha - beneath perception, above
+// the rounding of a fingerprinter that quantises. The live canvas is never
+// touched: only the copies a readback hands to script or to an encoder.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HTML_CANVAS_SEOUL_CANVAS_FARBLING_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HTML_CANVAS_SEOUL_CANVAS_FARBLING_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "base/containers/span.h"
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/core/frame/seoul_farbling.h"
+
+class SkPixmap;
+
+namespace blink {
+
+class ExecutionContext;
+class StaticBitmapImage;
+
+// getImageData: perturbs the ImageData's own pixmap in place. `origin` is the
+// readback's top-left corner in canvas coordinates - the sx, sy the script
+// asked for - without which two different sub-rectangles would disagree.
+CORE_EXPORT void SeoulFarbleCanvasReadback(const SkPixmap& pixmap,
+                                           int origin_x,
+                                           int origin_y,
+                                           ExecutionContext* context);
+
+// toDataURL, toBlob, convertToBlob: returns a farbled CPU copy of `image` for
+// handing to an encoder, or `image` unchanged when farbling is off for
+// `context` or the copy cannot be made.
+CORE_EXPORT scoped_refptr<StaticBitmapImage> SeoulMaybeFarbleForReadback(
+    scoped_refptr<StaticBitmapImage> image,
+    ExecutionContext* context);
+
+// WebGL readPixels: perturbs the RGBA8 rows written into `pixels`, script's own
+// buffer. `drawing_buffer_height` converts WebGL's bottom-left origin into the
+// top-left space the 2D readbacks use, so the two APIs cannot disagree about a
+// pixel of the same canvas. Every write stays inside the span.
+CORE_EXPORT void SeoulFarbleWebGLReadback(base::span<uint8_t> pixels,
+                                          int origin_x,
+                                          int origin_y,
+                                          int width,
+                                          int height,
+                                          size_t row_bytes,
+                                          int drawing_buffer_height,
+                                          ExecutionContext* context);
+
+// The primitive the readbacks share. `pixmap` must reference a writable copy
+// owned by the caller - never a canvas's own backing store. `flip_height` is 0
+// for a top-left readback, or the surface height for a bottom-left one.
+CORE_EXPORT void SeoulFarblePixels(const SkPixmap& pixmap,
+                                   int origin_x,
+                                   int origin_y,
+                                   int flip_height,
+                                   uint64_t token);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HTML_CANVAS_SEOUL_CANVAS_FARBLING_H_
