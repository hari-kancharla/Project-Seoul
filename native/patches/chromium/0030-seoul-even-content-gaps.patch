-gfx::Insets GetSeoulContentSeparationInsets() {
-#if BUILDFLAG(IS_MAC)
-  // Zen's macOS splitter occupies two DIPs of the normal eight-DIP leading
-  // separation. The web surface is therefore six DIPs from the rail while the
-  // remaining three sides retain the authored eight-DIP material gap.
-  return gfx::Insets::TLBR(kSeoulContentSeparation, 6, kSeoulContentSeparation,
-                           kSeoulContentSeparation);
-#else
-  return gfx::Insets(kSeoulContentSeparation);
-#endif
+// The same visible gap on all four sides.
+//
+// `leading_already_applied` is any leading inset the caller has already added
+// that is platform compensation rather than gap - in practice the two DIPs
+// macOS contributes in compact mode. Subtracting it here keeps the gap the user
+// sees at eight DIPs in every mode.
+//
+// This used to be a flat six on the leading edge for macOS. That produced the
+// right total in compact mode (two plus six) and the wrong one everywhere else:
+// expanded, nothing contributed the missing two, so the page sat six DIPs from
+// the rail and eight from the window's other three edges.
+gfx::Insets GetSeoulContentSeparationInsets(int leading_already_applied) {
+  const int leading =
+      std::max(0, kSeoulContentSeparation - leading_already_applied);
+  return gfx::Insets::TLBR(kSeoulContentSeparation, leading,
+                           kSeoulContentSeparation, kSeoulContentSeparation);
 }
 
