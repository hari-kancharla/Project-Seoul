+void LocationBarView::OnSeoulHandsetButtonPressed() {
+  content::WebContents* const contents = GetWebContents();
+  if (!contents || !seoul_handset_button_) {
+    return;
+  }
+  // A device lab needs a picker as the primary interaction, not a single
+  // hardcoded device behind a plain toggle - "which phone" is the question
+  // being asked here, and a bare on/off control cannot answer it. Selecting
+  // an item reloads the page under the new identity, same as the old toggle
+  // did; the control's own appearance is recomputed on the next layout pass
+  // once the menu closes, the same way the boost button's menu is.
+  seoul_handset_picker_menu_.Show(seoul_handset_button_, contents);
+}
