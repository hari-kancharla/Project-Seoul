+// Copyright 2026 The Project Seoul Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Handset, for the device-presentation affordance in the address field. A
+// phone outline is the one glyph every user already reads as "show me the
+// mobile version"; the drawing is Seoul's own and matches the 18-DIP,
+// 1.5-stroke rail set.
+//
+// Two parts, so it cannot be misread as a generic rounded rectangle: a tall
+// rounded body, and a short speaker line inset at the top. The proportions are
+// a phone's, not a tablet's - 8 wide by 14 tall - because the action it names
+// presents the page at phone width.
+CANVAS_DIMENSIONS, 18,
+STROKE, 1.5,
+MOVE_TO, 7, 2,
+LINE_TO, 11, 2,
+R_ARC_TO, 2, 2, 0, 0, 1, 2, 2,
+LINE_TO, 13, 14,
+R_ARC_TO, 2, 2, 0, 0, 1, -2, 2,
+LINE_TO, 7, 16,
+R_ARC_TO, 2, 2, 0, 0, 1, -2, -2,
+LINE_TO, 5, 4,
+R_ARC_TO, 2, 2, 0, 0, 1, 2, -2,
+CLOSE,
+NEW_PATH,
+STROKE, 1.5,
+MOVE_TO, 8, 4.5,
+LINE_TO, 10, 4.5,
