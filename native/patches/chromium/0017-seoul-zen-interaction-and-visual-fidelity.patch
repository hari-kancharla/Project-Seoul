+// Paints Zen's 0.5-DIP outline instead of rounding a nominal one-pixel
+// stroke. Keeping the stroke in DIP space yields one physical pixel on a 2x
+// display without turning it into a heavy two-pixel ring.
+class SeoulOmniboxBackdropPainter final : public views::Painter {
+ public:
+  SeoulOmniboxBackdropPainter(SkColor background_color, SkColor outline_color)
+      : background_color_(background_color), outline_color_(outline_color) {}
+
+  SeoulOmniboxBackdropPainter(const SeoulOmniboxBackdropPainter&) = delete;
+  SeoulOmniboxBackdropPainter& operator=(const SeoulOmniboxBackdropPainter&) =
+      delete;
+  ~SeoulOmniboxBackdropPainter() override = default;
+
+  gfx::Size GetMinimumSize() const override { return gfx::Size(); }
+
+  void Paint(gfx::Canvas* canvas, const gfx::Size& size) override {
+    if (size.IsEmpty()) {
+      return;
+    }
+
+    const gfx::RectF bounds{gfx::Rect(size)};
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(background_color_);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    canvas->DrawRoundRect(bounds, kSeoulOmniboxCornerRadius, flags);
+
+    gfx::RectF outline_bounds = bounds;
+    outline_bounds.Inset(gfx::InsetsF(kSeoulOmniboxHairlineWidth / 2.0f));
+    flags.setColor(outline_color_);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(kSeoulOmniboxHairlineWidth);
+    canvas->DrawRoundRect(
+        outline_bounds,
+        kSeoulOmniboxCornerRadius - kSeoulOmniboxHairlineWidth / 2.0f, flags);
+  }
+
+ private:
+  const SkColor background_color_;
+  const SkColor outline_color_;
+};
+
+// A textured, painted layer for CSS-style rounded outer shadows. Unlike
+// ViewShadow this preserves Zen's authored offset, blur, spread, and opacity.
+// The layer is sized for the maximum blur up front so the Actions glow can
+// animate without changing the surface hierarchy or clipping its blur.
+class SeoulOmniboxShadowView final : public views::View {
+  METADATA_HEADER(SeoulOmniboxShadowView, views::View)
+
+ public:
+  SeoulOmniboxShadowView(gfx::Vector2d offset,
+                         float css_blur_radius,
+                         int spread,
+                         float maximum_css_blur_radius)
+      : offset_(offset),
+        css_blur_radius_(css_blur_radius),
+        spread_(spread),
+        maximum_css_blur_radius_(maximum_css_blur_radius) {
+    SetProperty(views::kViewIgnoredByLayoutKey, true);
+    SetCanProcessEventsWithinSubtree(false);
+    SetPaintToLayer();
+    DCHECK_EQ(ui::LAYER_TEXTURED, layer()->type());
+    layer()->SetFillsBoundsOpaquely(false);
+  }
+
+  SeoulOmniboxShadowView(const SeoulOmniboxShadowView&) = delete;
+  SeoulOmniboxShadowView& operator=(const SeoulOmniboxShadowView&) = delete;
+  ~SeoulOmniboxShadowView() override = default;
+
+  void SetContentSize(const gfx::Size& content_size) {
+    if (content_size_ == content_size) {
+      return;
+    }
+    content_size_ = content_size;
+    if (content_size_.IsEmpty()) {
+      SetBoundsRect(gfx::Rect());
+      return;
+    }
+
+    gfx::Rect caster_bounds(gfx::Point(), content_size_);
+    caster_bounds.Inset(gfx::Insets(std::max(0, -spread_)));
+    const gfx::ShadowValues maximum_shadow = {gfx::ShadowValue(
+        offset_, 2.0 * maximum_css_blur_radius_, SK_ColorBLACK)};
+    gfx::Rect paint_bounds = caster_bounds;
+    paint_bounds.Inset(gfx::ShadowValue::GetMargin(maximum_shadow));
+    content_origin_ = gfx::Point(-paint_bounds.x(), -paint_bounds.y());
+    SetBoundsRect(paint_bounds);
+  }
+
+  void SetShadowColor(SkColor color) {
+    if (shadow_color_ == color) {
+      return;
+    }
+    shadow_color_ = color;
+    SchedulePaint();
+  }
+
+  void SetGlowAnimationProgress(double progress) {
+    progress = std::clamp(progress, 0.0, 1.0);
+    const float css_blur_radius =
+        kSeoulOmniboxGlowStartBlur +
+        (kSeoulOmniboxGlowEndBlur - kSeoulOmniboxGlowStartBlur) * progress;
+    const float opacity = static_cast<float>(1.0 - progress);
+    if (css_blur_radius_ == css_blur_radius && opacity_multiplier_ == opacity) {
+      return;
+    }
+    css_blur_radius_ = css_blur_radius;
+    opacity_multiplier_ = opacity;
+    SchedulePaint();
+  }
+
+  float css_blur_radius_for_testing() const { return css_blur_radius_; }
+  float opacity_multiplier_for_testing() const { return opacity_multiplier_; }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    if (content_size_.IsEmpty() || opacity_multiplier_ <= 0.0f ||
+        SkColorGetA(shadow_color_) == 0) {
+      return;
+    }
+
+    const gfx::RectF border_bounds(gfx::Rect(content_origin_, content_size_));
+    gfx::RectF caster_bounds = border_bounds;
+    caster_bounds.Inset(gfx::InsetsF(std::max(0, -spread_)));
+    const float caster_radius =
+        std::max(0.0f, kSeoulOmniboxCornerRadius + spread_);
+
+    const int alpha = static_cast<int>(
+        std::round(SkColorGetA(shadow_color_) * opacity_multiplier_));
+    const SkColor animated_color = SkColorSetA(
+        shadow_color_, static_cast<SkAlpha>(std::clamp(alpha, 0, 255)));
+    const gfx::ShadowValues shadows = {
+        gfx::ShadowValue(offset_, 2.0 * css_blur_radius_, animated_color)};
+
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SK_ColorTRANSPARENT);
+    flags.setLooper(gfx::CreateShadowDrawLooper(shadows));
+
+    const SkRRect clip_rrect = SkRRect::MakeRectXY(
+        gfx::RectFToSkRect(border_bounds), kSeoulOmniboxCornerRadius,
+        kSeoulOmniboxCornerRadius);
+    const SkRRect caster_rrect = SkRRect::MakeRectXY(
+        gfx::RectFToSkRect(caster_bounds), caster_radius, caster_radius);
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    canvas->sk_canvas()->clipRRect(clip_rrect, SkClipOp::kDifference, true);
+    canvas->sk_canvas()->drawRRect(caster_rrect, flags);
+  }
+
+ private:
+  const gfx::Vector2d offset_;
+  float css_blur_radius_;
+  const int spread_;
+  const float maximum_css_blur_radius_;
+  gfx::Size content_size_;
+  gfx::Point content_origin_;
+  SkColor shadow_color_ = SK_ColorTRANSPARENT;
+  float opacity_multiplier_ = 1.0f;
+};
+
+BEGIN_METADATA(SeoulOmniboxShadowView)
+END_METADATA
