+void BrowserView::LayoutSeoulOmniboxSurface() {
+  if (!seoul_omnibox_floating_ || !toolbar_ || !seoul_omnibox_surface_ ||
+      toolbar_->location_bar_view()->parent() != seoul_omnibox_surface_) {
+    return;
+  }
+
+  constexpr int kZenFloatingResultsHeight = 333;
+  const gfx::Rect window_bounds = GetLocalBounds();
+  const int width = CalculateSeoulOmniboxWidthForTesting(window_bounds.width());
+  const int x = (window_bounds.width() - width) / 2;
+  const int action_height =
+      IsSeoulOmniboxActionMode()
+          ? seoul_omnibox_action_view_->GetPreferredSize().height()
+          : 0;
+  const int popup_viewport_height =
+      seoul_omnibox_popup_view_ ? std::min(seoul_omnibox_popup_content_height_,
+                                           kSeoulOmniboxResultsViewportHeight)
+                                : 0;
+  const int popup_height = popup_viewport_height > 0
+                               ? kSeoulOmniboxResultsTopInset +
+                                     popup_viewport_height +
+                                     kSeoulOmniboxResultsBottomInset
+                               : 0;
+  const int surface_height =
+      kSeoulOmniboxHeight + std::max(action_height, popup_height);
+  const int reference_height =
+      std::max(kZenFloatingResultsHeight, surface_height);
+  const int y = (window_bounds.height() - reference_height) / 2;
+  seoul_omnibox_surface_->SetBounds(x, y, width, surface_height);
+  const gfx::Size surface_size(width, surface_height);
+  if (seoul_omnibox_shadow_) {
+    static_cast<SeoulOmniboxShadowView*>(seoul_omnibox_shadow_.get())
+        ->SetContentSize(surface_size);
+  }
+  if (seoul_omnibox_glow_) {
+    static_cast<SeoulOmniboxShadowView*>(seoul_omnibox_glow_.get())
+        ->SetContentSize(surface_size);
+  }
+  seoul_omnibox_backdrop_->SetBounds(0, 0, width, surface_height);
+  toolbar_->location_bar_view()->SetBounds(0, 0, width, kSeoulOmniboxHeight);
+  if (seoul_omnibox_action_view_) {
+    seoul_omnibox_action_view_->SetBounds(0, kSeoulOmniboxHeight, width,
+                                          action_height);
+  }
+  if (seoul_omnibox_popup_scroll_view_ && seoul_omnibox_popup_contents_ &&
+      seoul_omnibox_popup_view_) {
+    seoul_omnibox_popup_contents_->SetPreferredSize(
+        gfx::Size(width, seoul_omnibox_popup_content_height_));
+    seoul_omnibox_popup_contents_->SetSize(
+        gfx::Size(width, seoul_omnibox_popup_content_height_));
+    seoul_omnibox_popup_view_->SetBounds(0, 0, width,
+                                         seoul_omnibox_popup_content_height_);
+    seoul_omnibox_popup_scroll_view_->SetBounds(
+        0, kSeoulOmniboxHeight + kSeoulOmniboxResultsTopInset, width,
+        popup_viewport_height);
+    seoul_omnibox_popup_scroll_view_->DeprecatedLayoutImmediately();
+  }
+}
