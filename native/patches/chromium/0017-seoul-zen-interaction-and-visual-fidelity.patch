+void BrowserView::ReparentToolbarToSeoulRail() {
+  if (!vertical_tab_strip_region_view_ || !toolbar_) {
+    return;
+  }
+
+  // View::DoRemoveChildView de-registers the child from its parent's layout
+  // manager *before* it dispatches removal notifications, but clears
+  // View::parent() only after. Any observer reached from those notifications
+  // that re-enters Seoul's sidebar presentation would therefore see a stale
+  // parent and call SetVisible() on a toolbar the layout manager no longer
+  // tracks, which CHECKs in LayoutManagerBase::ViewVisibilitySet. Suppress the
+  // presentation update for the duration; both branches below re-apply the
+  // correct presentation once the hierarchy is settled.
+  const base::AutoReset<bool> reparenting(&seoul_toolbar_reparenting_, true);
+
+  views::View* const old_parent = toolbar_->parent();
+  if (old_parent != vertical_tab_strip_region_view_) {
+    auto owned_toolbar = old_parent->RemoveChildViewT(toolbar_);
+    toolbar_ = vertical_tab_strip_region_view_->AddChildViewAt(
+        std::move(owned_toolbar), 0);
+  }
+
+  // The native traffic lights and 34-DIP navigation buttons share the same
+  // 38-DIP header row. AppKit and the toolbar therefore already have the same
+  // vertical center; adding a rail-specific top margin visibly drops the
+  // navigation row below the window controls.
+  toolbar_->ClearProperty(views::kMarginsKey);
+  toolbar_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToMinimum,
+                               views::MaximumFlexSizeRule::kPreferred)
+          .WithOrder(1));
+
+  auto* controller = tabs::VerticalTabStripStateController::From(browser_);
+  toolbar_->SetSeoulSidebarPresentation(
+      controller && controller->IsCollapsed() &&
+      !vertical_tab_strip_region_view_->is_expanded_on_hover());
+
+  if (old_parent) {
+    old_parent->InvalidateLayout();
+  }
+  vertical_tab_strip_region_view_->InvalidateLayout();
+}
+
+void BrowserView::ReparentToolbarToTopContainer() {
+  if (!top_container_ || !toolbar_) {
+    return;
+  }
+
+  // See ReparentToolbarToSeoulRail: removal notifications run while the layout
+  // manager has already forgotten the child but View::parent() still points at
+  // the old parent.
+  const base::AutoReset<bool> reparenting(&seoul_toolbar_reparenting_, true);
+
+  views::View* const old_parent = toolbar_->parent();
+  if (old_parent != top_container_) {
+    auto owned_toolbar = old_parent->RemoveChildViewT(toolbar_);
+    toolbar_ = top_container_->AddChildViewAt(std::move(owned_toolbar), 0);
+  }
+  toolbar_->ClearProperty(views::kMarginsKey);
+  toolbar_->ClearProperty(views::kFlexBehaviorKey);
+  toolbar_->RestoreSeoulTopToolbarPresentation();
+  if (browser_widget_ && browser_widget_->browser_native_widget()) {
+    browser_widget_->browser_native_widget()
+        ->SetSeoulCompactFrameControlsVisible(true);
+  }
+
+  if (old_parent) {
+    old_parent->InvalidateLayout();
+  }
+  top_container_->InvalidateLayout();
+}
+
+void BrowserView::ApplySeoulLayoutMode(bool frame_reflow_handled_by_caller) {
+  if (!vertical_tab_strip_region_view_ || !toolbar_) {
+    return;
+  }
+
+  auto* controller = tabs::VerticalTabStripStateController::From(browser_);
+  const bool was_single_compact_collapsed =
+      IsSeoulToolbarIntegrated() && controller && controller->IsCollapsed() &&
+      vertical_tab_strip_region_view_->IsSeoulCompactModeEnabled();
+  seoul_layout_mode_ = seoul::GetSeoulLayoutMode(GetProfile()->GetPrefs());
+  const bool vertical_tabs_visible =
+      controller && controller->ShouldDisplayVerticalTabs();
+  const bool integrate_toolbar =
+      vertical_tabs_visible &&
+      seoul_layout_mode_ == seoul::SeoulLayoutMode::kSingle;
+  views::View* const previous_toolbar_parent = toolbar_->parent();
+
+  LocationBarView* location_bar = toolbar_->location_bar_view();
+  views::FocusManager* focus_manager = GetFocusManager();
+  views::View* focused_view =
+      focus_manager ? focus_manager->GetFocusedView() : nullptr;
+  const bool location_bar_had_focus =
+      location_bar && focused_view && location_bar->Contains(focused_view);
+
+  if (was_single_compact_collapsed && vertical_tabs_visible &&
+      seoul_layout_mode_ == seoul::SeoulLayoutMode::kMultiple) {
+    // Multiple reparents the toolbar before its durable expand policy runs.
+    // Carry the actual five-DIP Single+Compact endpoint through that reparent
+    // so the first expand frame cannot fall back to the 60-DIP icon rail.
+    vertical_tab_strip_region_view_->ArmSeoulCompactExit();
+  } else if (!vertical_tabs_visible ||
+             seoul_layout_mode_ != seoul::SeoulLayoutMode::kSingle) {
+    // Forced Collapsed is a terminal 60-DIP presentation and may no-op when the
+    // controller is already collapsed. Clear any prior compact handoff now so
+    // a later Collapsed -> Multiple expand starts from the real 60-DIP width.
+    vertical_tab_strip_region_view_->ClearSeoulCompactTransition();
+  }
+
+  // Dock the floating location bar into the same ToolbarView before moving the
+  // toolbar. The View and its OmniboxView are retained; only ownership changes.
+  if (!integrate_toolbar && seoul_omnibox_floating_) {
+    if (seoul_omnibox_action_mode_) {
+      HideSeoulOmniboxActions(/*restore_page_focus=*/false);
+    }
+    SetSeoulOmniboxFloating(false);
+  }
+
+  if (integrate_toolbar) {
+    ReparentToolbarToSeoulRail();
+  } else {
+    ReparentToolbarToTopContainer();
+  }
+
+  if (controller) {
+    switch (seoul_layout_mode_) {
+      case seoul::SeoulLayoutMode::kSingle:
+        controller->SetSeoulLayoutCollapsePolicy(std::nullopt);
+        break;
+      case seoul::SeoulLayoutMode::kMultiple:
+        controller->SetSeoulLayoutCollapsePolicy(false);
+        break;
+      case seoul::SeoulLayoutMode::kCollapsed:
+        controller->SetSeoulLayoutCollapsePolicy(true);
+        break;
+    }
+  }
+
+  // AppKit positions the native traffic lights from the active chrome host.
+  // A rail/top reparent does not emit Chromium's tab-strip orientation event,
+  // so force the same one-shot native reflow before laying out the new host.
+  if (initialized_ && !frame_reflow_handled_by_caller &&
+      toolbar_->parent() != previous_toolbar_parent) {
+    GetFrameView()->OnTabStripStateChanged();
+  }
+
+  InvalidateLayout();
+  if (initialized_) {
+    DeprecatedLayoutImmediately();
+  }
+
+  if (location_bar_had_focus) {
+    // A focused Zen address field stays in the floating surface while layout
+    // modes are changed. Restricting this to edited text leaves an already
+    // focused, empty field stranded in the narrow rail after returning to
+    // Single Toolbar.
+    if (integrate_toolbar && location_bar) {
+      SetSeoulOmniboxFloating(true);
+    }
+    if (LocationBarView* current_location_bar = toolbar_->location_bar_view()) {
+      current_location_bar->FocusLocation(
+          /*is_user_initiated=*/false,
+          /*clear_focus_if_failed=*/false);
+    }
+  }
+
+  if (seoul::ShellController* shell = GetSeoulShellController(browser_.get())) {
+    shell->RefreshAppearanceLayoutModeState();
+  }
+}
