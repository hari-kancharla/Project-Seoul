+
+void BrowserView::SetSeoulOmniboxPopupView(views::View* popup_view,
+                                           int results_content_height) {
+  if (!popup_view || results_content_height <= 0) {
+    if (seoul_omnibox_popup_view_ && seoul_omnibox_popup_contents_ &&
+        seoul_omnibox_popup_view_->parent() == seoul_omnibox_popup_contents_) {
+      seoul_omnibox_popup_contents_->RemoveChildView(seoul_omnibox_popup_view_);
+    }
+    if (seoul_omnibox_popup_scroll_view_ &&
+        seoul_omnibox_popup_scroll_view_->parent() == seoul_omnibox_surface_) {
+      seoul_omnibox_surface_->RemoveChildViewT(
+          seoul_omnibox_popup_scroll_view_);
+    }
+    seoul_omnibox_popup_scroll_view_ = nullptr;
+    seoul_omnibox_popup_contents_ = nullptr;
+    seoul_omnibox_popup_view_ = nullptr;
+    seoul_omnibox_popup_content_height_ = 0;
+    LayoutSeoulOmniboxSurface();
+    return;
+  }
+
+  if (!CanHostSeoulOmniboxPopup()) {
+    return;
+  }
+
+  if (seoul_omnibox_popup_view_ && seoul_omnibox_popup_view_ != popup_view) {
+    SetSeoulOmniboxPopupView(/*popup_view=*/nullptr,
+                             /*results_content_height=*/0);
+  }
+
+  if (!seoul_omnibox_popup_scroll_view_) {
+    auto contents = std::make_unique<views::View>();
+    seoul_omnibox_popup_contents_ = contents.get();
+
+    // Keep selection scrolling synchronous with row layout. Layer-backed
+    // scrolling can drop an offset requested in the same commit as a content
+    // resize, leaving the selected result clipped until a later interaction.
+    auto scroll_view = std::make_unique<views::ScrollView>(
+        views::ScrollView::ScrollWithLayers::kDisabled);
+    scroll_view->SetBackgroundColor(kColorOmniboxResultsBackground);
+    scroll_view->SetHorizontalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kDisabled);
+    scroll_view->SetVerticalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kHiddenButEnabled);
+    scroll_view->SetAllowKeyboardScrolling(false);
+    scroll_view->SetUseContentsPreferredSize(true);
+    scroll_view->SetContents(std::move(contents));
+    seoul_omnibox_popup_scroll_view_ =
+        seoul_omnibox_surface_->AddChildView(std::move(scroll_view));
+  }
+
+  if (popup_view->parent() != seoul_omnibox_popup_contents_) {
+    if (popup_view->parent()) {
+      popup_view->parent()->RemoveChildView(popup_view);
+    }
+    seoul_omnibox_popup_contents_->AddChildViewRaw(popup_view);
+  }
+  seoul_omnibox_popup_view_ = popup_view;
+  seoul_omnibox_popup_content_height_ = results_content_height;
+  LayoutSeoulOmniboxSurface();
+}
