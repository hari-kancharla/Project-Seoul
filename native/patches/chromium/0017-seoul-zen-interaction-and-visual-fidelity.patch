+void BrowserView::OnLiveWindowSnapshotChanged(
+    const seoul::LiveWindowSnapshot& snapshot) {
+  const SessionID window = browser_->session_id();
+  if (!window.is_valid() ||
+      snapshot.window != seoul::LiveWindowKey::FromSessionId(window.id())) {
+    return;
+  }
+
+  // URL/loading changes can retire the placeholder without selecting another
+  // tab. Recheck after the lifecycle publication completes so stale floating
+  // new-tab state is docked and its pending disposition is cleared.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&BrowserView::MaybeShowActiveSeoulNewTabPlaceholderSurface,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
