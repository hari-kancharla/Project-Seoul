+class SeoulOmniboxSearchModeAnimation final : public gfx::LinearAnimation {
+ public:
+  SeoulOmniboxSearchModeAnimation(views::View* surface,
+                                  SeoulOmniboxShadowView* glow,
+                                  bool show_glow)
+      : gfx::LinearAnimation(
+            show_glow ? base::Seconds(1) : base::Milliseconds(250),
+            60,
+            nullptr),
+        surface_(surface),
+        glow_(glow),
+        show_glow_(show_glow) {}
+
+  SeoulOmniboxSearchModeAnimation(const SeoulOmniboxSearchModeAnimation&) =
+      delete;
+  SeoulOmniboxSearchModeAnimation& operator=(
+      const SeoulOmniboxSearchModeAnimation&) = delete;
+  ~SeoulOmniboxSearchModeAnimation() override = default;
+
+ protected:
+  void AnimateToState(double state) override {
+    if (!surface_ || !surface_->layer()) {
+      return;
+    }
+
+    // Zen's motion animation pulses the complete URL bar 1 -> .98 -> 1 in
+    // 250ms. Its one-second glow continues after the scale has settled.
+    const double pulse_state = std::min(state * (show_glow_ ? 4.0 : 1.0), 1.0);
+    static const gfx::CubicBezier kEase(0.25, 0.1, 0.25, 1.0);
+    const double segment =
+        pulse_state < 0.5 ? pulse_state * 2.0 : (pulse_state - 0.5) * 2.0;
+    const double eased = kEase.Solve(segment);
+    const double scale =
+        pulse_state < 0.5 ? 1.0 - 0.02 * eased : 0.98 + 0.02 * eased;
+    SetCenteredScale(surface_->layer(), surface_->GetLocalBounds(), scale);
+
+    if (!show_glow_ || !glow_) {
+      return;
+    }
+    // The source animation is a CSS outer shadow, not a blurred filled
+    // rectangle: ease its radius from 20px to 250px while the color resolves
+    // to transparent over exactly one second.
+    static const gfx::CubicBezier kEaseOut(0.0, 0.0, 0.58, 1.0);
+    glow_->SetGlowAnimationProgress(kEaseOut.Solve(state));
+  }
+
+ private:
+  static void SetCenteredScale(ui::Layer* layer,
+                               const gfx::Rect& bounds,
+                               double scale) {
+    const float center_x = bounds.width() / 2.0f;
+    const float center_y = bounds.height() / 2.0f;
+    gfx::Transform transform;
+    transform.Translate(center_x, center_y);
+    transform.Scale(scale, scale);
+    transform.Translate(-center_x, -center_y);
+    layer->SetTransform(transform);
+  }
+
+  raw_ptr<views::View> surface_;
+  raw_ptr<SeoulOmniboxShadowView> glow_;
+  const bool show_glow_;
+};
