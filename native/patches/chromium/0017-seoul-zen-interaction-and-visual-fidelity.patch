     for (const auto& [sequence, sequence_spec] :
@@ -191,13 +192,36 @@ class BrowserAnimationController::GroupData : public gfx::AnimationDelegate {
 
   // gfx::AnimationDelegate:
   void AnimationEnded(const gfx::Animation*) override {
+    // A compositor tick can already be queued when Cancel() stops the
+    // animator. Ignore that stale terminal callback after the motion state has
+    // been cleared.
+    if (!current_motion_) {
+      return;
+    }
     UpdateValues(current_duration_, 1.0);
+    // A subscriber may start a new motion synchronously from kEnded - the
+    // vertical rail does exactly that, chaining an expand-on-hover reveal off
+    // the end of a collapse. Clearing unconditionally would erase the *new*
+    // motion's state while its animator is still running, leaving
+    // IsAnimating() false for a live animation; layout would then take the
+    // static branch and snap to the end value instead of animating. Only clear
+    // when this motion is still the current one.
+    const uint64_t ended_generation = motion_generation_;
     Notify(BrowserAnimationUpdate::kEnded);
+    if (motion_generation_ != ended_generation) {
+      return;
+    }
     current_motion_ = BrowserAnimationMotion();
     current_values_.clear();
   }
 
   void AnimationProgressed(const gfx::Animation* animation) override {
+    // Cancel() deliberately clears the motion before stopping the animator so
+    // subscribers observe a canceled state. A previously queued compositor
+    // tick must not try to update that cleared motion.
+    if (!current_motion_) {
+      return;
+    }
     const double unscaled_percent = animation->GetCurrentValue();
     const double scaled_percent = gfx::Tween::CalculateValue(
         current_motion_spec_.global_tween, unscaled_percent);
@@ -221,6 +245,9 @@ class BrowserAnimationController::GroupData : public gfx::AnimationDelegate {
 
   std::map<BrowserAnimationSequence, double> current_values_;
   BrowserAnimationMotion current_motion_;
+  // Bumped by every Start(). Lets AnimationEnded() detect that a subscriber
+  // started a replacement motion during its own kEnded notification.
+  uint64_t motion_generation_ = 0;
   internal::BrowserAnimationMotionSpecification current_motion_spec_;
   base::TimeDelta current_duration_;
   std::unique_ptr<Animator> animator_;
