+
+void LocationBarView::UpdateSeoulSidebarChromeOpacity() {
+  if (!location_icon_view_ || !page_action_icon_container_ ||
+      !page_action_container_) {
+    return;
+  }
+
+  float opacity = 1.0f;
+  if (seoul_sidebar_mode_) {
+    // Zen authors identity/page-action visibility as a 150ms transition while
+    // its field hover lasts 200ms. Remap the shared animation so both timings
+    // remain exact without two competing hover state machines.
+    constexpr float kIdentityDurationFraction = 0.75f;
+    const float value = static_cast<float>(hover_animation_.GetCurrentValue());
+    opacity = hover_animation_.IsShowing()
+                  ? std::clamp(value / kIdentityDurationFraction, 0.0f, 1.0f)
+                  : std::clamp((value - (1.0f - kIdentityDurationFraction)) /
+                                   kIdentityDurationFraction,
+                               0.0f, 1.0f);
+  }
+
+  for (views::View* view : std::array<views::View*, 3>{
+           location_icon_view_, page_action_icon_container_,
+           page_action_container_}) {
+    view->layer()->SetOpacity(opacity);
+  }
+
+  if (seoul_sidebar_mode_ && !seoul_sidebar_chrome_revealed_ &&
+      opacity == 0.0f) {
+    HideSeoulSidebarChromeAfterFade();
+  }
+}
+
+void LocationBarView::HideSeoulSidebarChromeAfterFade() {
+  if (!seoul_sidebar_mode_ || seoul_sidebar_chrome_revealed_) {
+    return;
+  }
+  location_icon_view_->SetVisible(false);
+  page_action_icon_container_->SetVisible(false);
+  page_action_container_->SetVisible(false);
+  InvalidateLayout();
+}
