+constexpr float kSeoulOmniboxCornerRadius = 12.0f;
+constexpr float kSeoulOmniboxHairlineWidth = 0.5f;
+constexpr float kSeoulOmniboxGlowStartBlur = 20.0f;
+constexpr float kSeoulOmniboxGlowEndBlur = 250.0f;
+constexpr int kSeoulOmniboxHeight = 62;
