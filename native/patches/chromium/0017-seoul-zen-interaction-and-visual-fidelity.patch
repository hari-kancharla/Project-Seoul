+TEST_P(TabCollectionAnimatingLayoutManagerTest, SeoulAddMotion) {
+  ON_CALL(*layout_manager_delegate(),
+          ShouldAnimateOpacityForAddAndRemove(testing::_))
+      .WillByDefault(testing::Return(true));
+  ON_CALL(*layout_manager_delegate(), ShouldUseSeoulMotion(testing::_))
+      .WillByDefault(testing::Return(true));
+
+  widget()->SetBounds(gfx::Rect(0, 0, 100, 100));
+  widget()->LayoutRootViewIfNecessary();
+
+  views::View* child =
+      host_view()->AddChildView(std::make_unique<views::View>());
+  host_view()->InvalidateLayout();
+  widget()->LayoutRootViewIfNecessary();
+
+  ASSERT_TRUE(child->layer());
+  EXPECT_TRUE(TabCollectionAnimatingLayoutManager::OwnsLayerForView(*child));
+  EXPECT_EQ(layout_manager()->animation_duration_for_testing(),
+            gfx::Animation::RichAnimationDuration(base::Milliseconds(120)));
+  EXPECT_FLOAT_EQ(0.0f, child->layer()->opacity());
+  if (IsAnimationDurationEnabled()) {
+    const gfx::Vector2dF scale = child->layer()->transform().To2dScale();
+    EXPECT_NEAR(0.95f, scale.x(), 0.001f);
+    EXPECT_NEAR(0.95f, scale.y(), 0.001f);
+  }
+
+  EXPECT_CALL(*layout_manager_delegate(), OnAnimationEnded());
+  if (IsAnimationDurationEnabled()) {
+    StepAnimationToFraction(0.5);
+    widget()->LayoutRootViewIfNecessary();
+    ASSERT_TRUE(child->layer());
+    const gfx::Vector2dF scale = child->layer()->transform().To2dScale();
+    const double value = gfx::Tween::CalculateValue(gfx::Tween::EASE_OUT, 0.5);
+    const float expected_scale =
+        gfx::Tween::FloatValueBetween(value, 0.95f, 1.0f);
+    EXPECT_NEAR(expected_scale, scale.x(), 0.001f);
+    EXPECT_NEAR(expected_scale, scale.y(), 0.001f);
+    EXPECT_NEAR(value, child->layer()->opacity(), 0.001f);
+  }
+  task_environment()->FastForwardBy(base::Seconds(1));
+  widget()->LayoutRootViewIfNecessary();
+
+  EXPECT_EQ(child->bounds(), gfx::Rect(0, 0, 100, 20));
+  EXPECT_FALSE(child->layer());
+  EXPECT_FALSE(TabCollectionAnimatingLayoutManager::OwnsLayerForView(*child));
+  EXPECT_EQ(layout_manager()->animation_duration_for_testing(),
+            gfx::Animation::RichAnimationDuration(base::Milliseconds(200)));
