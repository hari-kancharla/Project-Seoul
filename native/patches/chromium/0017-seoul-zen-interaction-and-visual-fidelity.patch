+SeoulLayoutMode GetSeoulLayoutMode(const PrefService* prefs) {
+  if (!prefs) {
+    return SeoulLayoutMode::kSingle;
+  }
+  const int value = prefs->GetInteger(kSeoulLayoutModePref);
+  if (value < static_cast<int>(SeoulLayoutMode::kMinValue) ||
