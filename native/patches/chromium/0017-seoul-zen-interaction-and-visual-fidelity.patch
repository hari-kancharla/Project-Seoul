+
+void VerticalTabView::SetSeoulPressed(bool pressed) {
+  if (pressed) {
+    if (!ShouldUseSeoulMotion() ||
+        TabCollectionAnimatingLayoutManager::OwnsLayerForView(*this)) {
+      return;
+    }
+    if (!layer()) {
+      SetPaintToLayer();
+      layer()->SetFillsBoundsOpaquely(false);
+      owns_seoul_press_layer_ = true;
+    } else if (!owns_seoul_press_layer_) {
+      // Another component owns this layer and may animate the same transform.
+      return;
+    }
+    seoul_press_active_ = true;
+  } else {
+    seoul_press_active_ = false;
+    if (!owns_seoul_press_layer_) {
+      return;
+    }
+  }
+
+  if (!layer()) {
+    owns_seoul_press_layer_ = false;
+    return;
+  }
+
+  const gfx::Transform target =
+      pressed ? CenteredScaleTransform(*this, kSeoulTabPressedScale)
+              : gfx::Transform();
+  if (!gfx::Animation::ShouldRenderRichAnimation()) {
+    layer()->SetTransform(target);
+    if (!pressed) {
+      ResetSeoulPressAnimation();
+    }
+    return;
+  }
+
+  views::AnimationBuilder builder;
+  builder.SetPreemptionStrategy(
+      ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET);
+  if (!pressed) {
+    builder.OnEnded(base::BindOnce(&VerticalTabView::FinishSeoulPressRelease,
+                                   weak_ptr_factory_.GetWeakPtr()));
+  }
+  builder.Once()
+      .SetDuration(kSeoulTabPressAnimationDuration)
+      .SetTransform(layer(), target, gfx::Tween::EASE_IN_OUT);
+}
+
+void VerticalTabView::FinishSeoulPressRelease() {
+  if (seoul_press_active_ || !owns_seoul_press_layer_ || !layer() ||
+      TabCollectionAnimatingLayoutManager::OwnsLayerForView(*this)) {
+    return;
+  }
+  layer()->SetTransform(gfx::Transform());
+  owns_seoul_press_layer_ = false;
+  DestroyLayer();
+}
+
+void VerticalTabView::ResetSeoulPressAnimation() {
+  seoul_press_active_ = false;
+  if (!owns_seoul_press_layer_) {
+    return;
+  }
+  owns_seoul_press_layer_ = false;
+  if (!layer()) {
+    return;
+  }
+  layer()->GetAnimator()->StopAnimating();
+  layer()->SetTransform(gfx::Transform());
+  DestroyLayer();
+}
