+class ToolbarView::SeoulToolbarPressAnimation final {
+ public:
+  explicit SeoulToolbarPressAnimation(ToolbarButton* button)
+      : button_(button),
+        state_changed_subscription_(button_->AddStateChangedCallback(
+            base::BindRepeating(
+                &SeoulToolbarPressAnimation::OnButtonStateChanged,
+                base::Unretained(this)))) {}
+
+  SeoulToolbarPressAnimation(const SeoulToolbarPressAnimation&) = delete;
+  SeoulToolbarPressAnimation& operator=(
+      const SeoulToolbarPressAnimation&) = delete;
+
+  ~SeoulToolbarPressAnimation() { Reset(); }
+
+  void Reset() {
+    pressed_ = false;
+    weak_ptr_factory_.InvalidateWeakPtrs();
+    if (!owns_layer_) {
+      return;
+    }
+
+    owns_layer_ = false;
+    if (!button_->layer()) {
+      return;
+    }
+    button_->layer()->GetAnimator()->StopAnimating();
+    button_->layer()->SetTransform(gfx::Transform());
+    button_->DestroyLayer();
+  }
+
+ private:
+  void OnButtonStateChanged() {
+    SetPressed(button_->GetState() == views::Button::STATE_PRESSED);
+  }
+
+  void SetPressed(bool pressed) {
+    if (pressed) {
+      if (!button_->layer()) {
+        button_->SetPaintToLayer();
+        button_->layer()->SetFillsBoundsOpaquely(false);
+        owns_layer_ = true;
+      } else if (!owns_layer_) {
+        // Never overwrite a transform owned by another toolbar component.
+        return;
+      }
+      pressed_ = true;
+    } else {
+      pressed_ = false;
+      if (!owns_layer_) {
+        return;
+      }
+    }
+
+    if (!button_->layer()) {
+      owns_layer_ = false;
+      return;
+    }
+
+    const gfx::Transform target =
+        pressed ? SeoulToolbarCenteredScaleTransform(
+                      *button_, kSeoulToolbarPressedScale)
+                : gfx::Transform();
+    if (!gfx::Animation::ShouldRenderRichAnimation()) {
+      button_->layer()->SetTransform(target);
+      if (!pressed) {
+        Reset();
+      }
+      return;
+    }
+
+    views::AnimationBuilder builder;
+    builder.SetPreemptionStrategy(
+        ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET);
+    if (!pressed) {
+      builder.OnEnded(base::BindOnce(
+          &SeoulToolbarPressAnimation::FinishRelease,
+          weak_ptr_factory_.GetWeakPtr()));
+    }
+    builder.Once()
+        .SetDuration(kSeoulToolbarPressAnimationDuration)
+        .SetTransform(button_->layer(), target, gfx::Tween::EASE_IN_OUT);
+  }
+
+  void FinishRelease() {
+    if (pressed_ || !owns_layer_ || !button_->layer()) {
+      return;
+    }
+    button_->layer()->SetTransform(gfx::Transform());
+    owns_layer_ = false;
+    button_->DestroyLayer();
+  }
+
+  const raw_ptr<ToolbarButton> button_;
+  base::CallbackListSubscription state_changed_subscription_;
+  bool pressed_ = false;
+  bool owns_layer_ = false;
+  base::WeakPtrFactory<SeoulToolbarPressAnimation> weak_ptr_factory_{this};
+};
