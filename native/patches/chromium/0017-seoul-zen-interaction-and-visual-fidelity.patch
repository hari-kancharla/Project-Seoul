+void ToolbarView::EnsureSeoulSidebarNavigationControls() {
+  CHECK(initialized_);
+
+  const auto callback = [](Browser* browser, int command,
+                           const ui::Event& event) {
+    chrome::ExecuteCommandWithDisposition(
+        browser, command, ui::DispositionFromEventFlags(event.flags()));
+  };
+  const auto initialize_button = [this](ToolbarButton* button) {
+    const int command = GetViewCommandMap().at(button->GetID());
+    button->set_tag(command);
+    button->SetEnabled(
+        browser_->command_controller()->IsCommandEnabled(command));
+    button->SetVisible(false);
+  };
+
+  // WebUI toolbar controls cannot be manually positioned in Seoul's native
+  // two-row rail. Lazily create Views fallbacks only for the controls WebUI
+  // owns, so ordinary Chromium toolbar windows retain their exact upstream
+  // child tree and behavior.
+  if (!back_ && !seoul_back_) {
+    auto button = std::make_unique<BackForwardButton>(
+        BackForwardButton::Direction::kBack,
+        base::BindRepeating(callback, browser_, IDC_BACK), browser_);
+    initialize_button(button.get());
+    seoul_back_ = AddChildView(std::move(button));
+  }
+  if (!forward_ && !seoul_forward_) {
+    auto button = std::make_unique<BackForwardButton>(
+        BackForwardButton::Direction::kForward,
+        base::BindRepeating(callback, browser_, IDC_FORWARD), browser_);
+    initialize_button(button.get());
+    seoul_forward_ = AddChildView(std::move(button));
+  }
+  if (!reload_ && !seoul_reload_) {
+    auto button = std::make_unique<ReloadButton>(
+        browser_->profile(), browser_->command_controller(),
+        /*window_metrics_manager=*/nullptr);
+    initialize_button(button.get());
+    seoul_reload_ = AddChildView(std::move(button));
+  }
+
+  CHECK(GetSeoulSidebarBackButton());
+  CHECK(GetSeoulSidebarForwardButton());
+  CHECK(GetSeoulSidebarReloadButton());
+}
+
+void ToolbarView::EnsureSeoulToolbarPressAnimations() {
