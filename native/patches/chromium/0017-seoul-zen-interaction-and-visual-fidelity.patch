@@ -0,0 +1,31 @@
+// Copyright 2026 The Project Seoul Authors
+// Use of this source code is governed by a BSD-style license.
+
+#include "chrome/app/seoul_development_keychain_policy.h"
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_MAC)
+#include "components/os_crypt/common/os_crypt_switches.h"
+#endif
+
+namespace seoul {
+
+bool DevelopmentBuildUsesMockKeychain() {
+#if BUILDFLAG(IS_MAC) && !defined(OFFICIAL_BUILD)
+  return true;
+#else
+  return false;
+#endif
+}
+
+void ApplyDevelopmentKeychainPolicy(base::CommandLine* command_line) {
+  CHECK(command_line);
+#if BUILDFLAG(IS_MAC) && !defined(OFFICIAL_BUILD)
+  command_line->AppendSwitch(os_crypt::switches::kUseMockKeychain);
+#endif
+}
+
+}  // namespace seoul
diff --git a/chrome/app/seoul_development_keychain_policy.h b/chrome/app/seoul_development_keychain_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..16bab72b793de1f4e0105d516215c32ccfcbb5b0
--- /dev/null
+++ b/chrome/app/seoul_development_keychain_policy.h
@@ -0,0 +1,25 @@
+// Copyright 2026 The Project Seoul Authors
+// Use of this source code is governed by a BSD-style license.
+
+#ifndef CHROME_APP_SEOUL_DEVELOPMENT_KEYCHAIN_POLICY_H_
+#define CHROME_APP_SEOUL_DEVELOPMENT_KEYCHAIN_POLICY_H_
+
+namespace base {
+class CommandLine;
+}
+
+namespace seoul {
+
+// Returns true only for a macOS development build. OFFICIAL_BUILD is the
+// release boundary: official products keep the real Keychain unless the user
+// explicitly supplied Chromium's mock-keychain switch.
+bool DevelopmentBuildUsesMockKeychain();
+
+// Applies the development default to `command_line`. This function is called
+// from ChromeMainDelegate::BasicStartupComplete(), before OSCrypt and profile
+// services initialize.
+void ApplyDevelopmentKeychainPolicy(base::CommandLine* command_line);
+
+}  // namespace seoul
+
+#endif  // CHROME_APP_SEOUL_DEVELOPMENT_KEYCHAIN_POLICY_H_
