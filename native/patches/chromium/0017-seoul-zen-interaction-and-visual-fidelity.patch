+
+int OmniboxPopupViewViews::CalculateVisibleResultsHeight() const {
+  const size_t result_size =
+      controller()->autocomplete_controller()->result().size();
+  const size_t direct_child_count = std::min(result_size, children().size());
+  auto children_span = base::span(children()).first(direct_child_count);
+  int height = std::accumulate(
+      children_span.begin(), children_span.end(), 0,
+      [](int current_height, const views::View* view) {
+        return view->GetVisible()
+                   ? current_height + view->GetPreferredSize().height()
+                   : current_height;
+      });
+  if (contextual_group_view_) {
+    height += contextual_group_view_->GetCurrentHeight();
+  }
+  return height;
+}
+
+bool OmniboxPopupViewViews::AttachToSeoulSurface() {
+  BrowserView* const browser_view = GetSeoulBrowserView();
+  if (!browser_view || !browser_view->CanHostSeoulOmniboxPopup()) {
+    return false;
+  }
+  browser_view->SetSeoulOmniboxPopupView(
+      this, std::max(1, CalculateVisibleResultsHeight()));
+  seoul_embedded_open_ = browser_view->IsHostingSeoulOmniboxPopup(this);
+  return seoul_embedded_open_;
+}
+
+void OmniboxPopupViewViews::DetachFromSeoulSurface() {
+  if (!seoul_embedded_open_) {
+    return;
+  }
+  if (BrowserView* const browser_view = GetSeoulBrowserView();
+      browser_view && browser_view->IsHostingSeoulOmniboxPopup(this)) {
+    browser_view->SetSeoulOmniboxPopupView(
+        /*popup_view=*/nullptr, /*results_content_height=*/0);
+  } else if (parent()) {
+    parent()->RemoveChildView(this);
+  }
+  seoul_embedded_open_ = false;
+}
