new file mode 100644
index 0000000000000000000000000000000000000000..ada125dc8327ccf578c97fb18ad80b05874770c7
--- /dev/null
+++ b/chrome/app/seoul_development_keychain_policy_unittest.cc
@@ -0,0 +1,30 @@
+// Copyright 2026 The Project Seoul Authors
+// Use of this source code is governed by a BSD-style license.
+
+#include "chrome/app/seoul_development_keychain_policy.h"
+
+#include "base/command_line.h"
+#include "build/build_config.h"
+#include "components/os_crypt/common/os_crypt_switches.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace seoul {
+namespace {
+
+TEST(SeoulDevelopmentKeychainPolicyTest, MatchesCompileTimeReleaseBoundary) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  ApplyDevelopmentKeychainPolicy(&command_line);
+
+#if BUILDFLAG(IS_MAC) && !defined(OFFICIAL_BUILD)
+  EXPECT_TRUE(DevelopmentBuildUsesMockKeychain());
+  EXPECT_TRUE(command_line.HasSwitch(os_crypt::switches::kUseMockKeychain));
+#else
+  EXPECT_FALSE(DevelopmentBuildUsesMockKeychain());
+#if BUILDFLAG(IS_MAC)
+  EXPECT_FALSE(command_line.HasSwitch(os_crypt::switches::kUseMockKeychain));
+#endif
+#endif
+}
+
+}  // namespace
+}  // namespace seoul
