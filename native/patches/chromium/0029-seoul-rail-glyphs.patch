diff --git a/chrome/app/vector_icons/seoul_collapse_sidebar.icon b/chrome/app/vector_icons/seoul_collapse_sidebar.icon
new file mode 100644
--- /dev/null
+++ b/chrome/app/vector_icons/seoul_collapse_sidebar.icon
@@ -0,0 +1,19 @@
+// Copyright 2026 The Project Seoul Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Collapse the rail: window frame, rail divider, arrow travelling back towards
+// the rail. Mirrors seoul_expand_sidebar so the control reads as one thing in
+// two states rather than two unrelated glyphs.
+CANVAS_DIMENSIONS, 18,
+STROKE, 1.5,
+ROUND_RECT, 1.75, 2.75, 14.5, 12.5, 2,
+MOVE_TO, 6.25, 3.5,
+V_LINE_TO, 14.5,
+NEW_PATH,
+STROKE, 1.5,
+MOVE_TO, 12.25, 6,
+LINE_TO, 9.25, 9,
+LINE_TO, 12.25, 12,
+MOVE_TO, 9.25, 9,
+H_LINE_TO, 13.75
diff --git a/chrome/app/vector_icons/seoul_reload.icon b/chrome/app/vector_icons/seoul_reload.icon
--- a/chrome/app/vector_icons/seoul_reload.icon
+++ b/chrome/app/vector_icons/seoul_reload.icon
@@ -2,17 +2,27 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
-// Open circular arrow with a light, rounded stroke. Its asymmetry keeps the
-// arrowhead crisp instead of producing the heavy Material refresh ring.
+// Circular arrow, redrawn.
+//
+// The previous glyph put a small open "V" outside the ring at roughly two
+// o'clock: three points drawn with STROKE, which renders two line segments
+// rather than a head, so at 18px it read as a tick sitting next to a circle.
+// Filling those same points did not fix it either - the triangle was too far
+// off the ring's path to be read as its end.
+//
+// This is one arc with a proper head ON the path. The arc opens at the top
+// right and the head sits exactly where the stroke stops, pointing along the
+// direction of travel, so the eye completes the circle.
 CANVAS_DIMENSIONS, 18,
-STROKE, 1.5,
-MOVE_TO, 15.45, 8.15,
-CUBIC_TO, 15.05, 4.7, 12.25, 2.25, 8.9, 2.25,
-CUBIC_TO, 5.2, 2.25, 2.25, 5.25, 2.25, 8.95,
-CUBIC_TO, 2.25, 12.7, 5.25, 15.7, 9, 15.7,
-CUBIC_TO, 12.45, 15.7, 15.25, 13.15, 15.65, 9.75,
+STROKE, 1.6,
+// Arc from just past twelve o'clock, anticlockwise all the way round to two.
+MOVE_TO, 9, 2.6,
+CUBIC_TO, 5.5, 2.6, 2.6, 5.5, 2.6, 9,
+CUBIC_TO, 2.6, 12.5, 5.5, 15.4, 9, 15.4,
+CUBIC_TO, 12.5, 15.4, 15.4, 12.5, 15.4, 9,
 NEW_PATH,
-STROKE, 1.5,
-MOVE_TO, 11.35, 6.35,
-LINE_TO, 15.45, 8.15,
-LINE_TO, 16.1, 3.75
+// The head, filled, centred on where the arc begins and pointing clockwise.
+MOVE_TO, 15.4, 9,
+LINE_TO, 12.5, 9,
+LINE_TO, 13.95, 6.2,
+CLOSE
diff --git a/chrome/browser/ui/views/toolbar/toolbar_view.cc b/chrome/browser/ui/views/toolbar/toolbar_view.cc
--- a/chrome/browser/ui/views/toolbar/toolbar_view.cc
+++ b/chrome/browser/ui/views/toolbar/toolbar_view.cc
@@ -540,7 +540,14 @@
             controller->RequestCollapse(enable_compact);
           },
           browser_)));
-  seoul_compact_button_->SetVectorIcon(kLeftPanelCloseIcon);
+  // Seoul's own glyph. kLeftPanelCloseIcon is a bare square and bar from
+  // Chromium's set; this is the rail's own motif - frame, divider, arrow.
+  // Safe here: the toolbar already links chrome/app/vector_icons (its reload
+  // button uses kSeoulReloadIcon). The same reference from
+  // chrome/browser/ui/tabs segfaults, because those icons are declared with a
+  // plain extern and no COMPONENT_EXPORT, so a component outside chrome/ that
+  // names one resolves to null at load.
+  seoul_compact_button_->SetVectorIcon(kSeoulCollapseSidebarIcon);
   seoul_compact_button_->SetTooltipText(u"Toggle compact sidebar");
   seoul_compact_button_->GetViewAccessibility().SetName(
       u"Toggle compact sidebar");
