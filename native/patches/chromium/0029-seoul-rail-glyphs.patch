diff --git a/chrome/app/vector_icons/seoul_collapse_sidebar.icon b/chrome/app/vector_icons/seoul_collapse_sidebar.icon
new file mode 100644
--- /dev/null
+++ b/chrome/app/vector_icons/seoul_collapse_sidebar.icon
@@ -0,0 +1,19 @@
+// Copyright 2026 The Project Seoul Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Collapse the rail: window frame, rail divider, arrow travelling back towards
+// the rail. Mirrors seoul_expand_sidebar so the control reads as one thing in
+// two states rather than two unrelated glyphs.
+CANVAS_DIMENSIONS, 18,
+STROKE, 1.5,
+ROUND_RECT, 1.75, 2.75, 14.5, 12.5, 2,
+MOVE_TO, 6.25, 3.5,
+V_LINE_TO, 14.5,
+NEW_PATH,
+STROKE, 1.5,
+MOVE_TO, 12.25, 6,
+LINE_TO, 9.25, 9,
+LINE_TO, 12.25, 12,
+MOVE_TO, 9.25, 9,
+H_LINE_TO, 13.75
diff --git a/chrome/app/vector_icons/seoul_reload.icon b/chrome/app/vector_icons/seoul_reload.icon
--- a/chrome/app/vector_icons/seoul_reload.icon
+++ b/chrome/app/vector_icons/seoul_reload.icon
@@ -2,17 +2,27 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
-// Open circular arrow with a light, rounded stroke. Its asymmetry keeps the
-// arrowhead crisp instead of producing the heavy Material refresh ring.
+// Circular arrow, computed rather than hand-placed.
+//
+// Two earlier attempts were drawn by eye and both read wrong at 18px: the
+// first put three stroked points outside the ring, which renders as two open
+// segments - a tick beside a circle - and the second filled those same points
+// but left them off the arc's path, producing a blob in the gap.
+//
+// This arc and head come from one calculation: a 300-degree sweep about
+// (9,9) at radius 6.1, with the head's base perpendicular to the radius at the
+// arc's start and its tip along the tangent, so the triangle sits ON the path
+// and points the way the circle turns. Clockwise, which is the direction every
+// mainstream browser's reload rotates.
 CANVAS_DIMENSIONS, 18,
-STROKE, 1.5,
-MOVE_TO, 15.45, 8.15,
-CUBIC_TO, 15.05, 4.7, 12.25, 2.25, 8.9, 2.25,
-CUBIC_TO, 5.2, 2.25, 2.25, 5.25, 2.25, 8.95,
-CUBIC_TO, 2.25, 12.7, 5.25, 15.7, 9, 15.7,
-CUBIC_TO, 12.45, 15.7, 15.25, 13.15, 15.65, 9.75,
+STROKE, 1.6,
+MOVE_TO, 5.95, 3.72,
+CUBIC_TO, 3.56, 5.1, 2.39, 7.91, 3.11, 10.58,
+CUBIC_TO, 3.82, 13.25, 6.24, 15.1, 9, 15.1,
+CUBIC_TO, 11.76, 15.1, 14.18, 13.25, 14.89, 10.58,
+CUBIC_TO, 15.61, 7.91, 14.44, 5.1, 12.05, 3.72,
 NEW_PATH,
-STROKE, 1.5,
-MOVE_TO, 11.35, 6.35,
-LINE_TO, 15.45, 8.15,
-LINE_TO, 16.1, 3.75
+MOVE_TO, 8.37, 2.32,
+LINE_TO, 5.05, 2.16,
+LINE_TO, 6.85, 5.28,
+CLOSE
\ No newline at end of file
