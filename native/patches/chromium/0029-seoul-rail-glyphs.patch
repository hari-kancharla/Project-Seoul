             controller->RequestCollapse(enable_compact);
           },
           browser_)));
-  seoul_compact_button_->SetVectorIcon(kLeftPanelCloseIcon);
+  // Seoul's own glyph. kLeftPanelCloseIcon is a bare square and bar from
+  // Chromium's set; this is the rail's own motif - frame, divider, arrow.
+  // Safe here: the toolbar already links chrome/app/vector_icons (its reload
