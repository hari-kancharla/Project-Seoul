+  if (!seoul_omnibox_action_view_) {
+    auto results = std::make_unique<seoul::SeoulOmniboxActionView>(
+        controller, base::BindRepeating(&BrowserView::ExecuteSeoulOmniboxAction,
+                                        weak_ptr_factory_.GetWeakPtr()));
+    results->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    seoul_omnibox_action_view_ = AddChildView(std::move(results));
+  }
+
+  OmniboxViewViews* omnibox = location_bar->omnibox_view();
+  omnibox->SetPlaceholderText(u"Search tabs, Spaces, and actions");
+  omnibox->SetUserText(std::u16string(), /*update_popup=*/false);
+  location_bar->GetOmniboxController()->StopAutocomplete(
+      /*clear_result=*/true);
+  seoul_omnibox_action_view_->SetQuery(std::string_view());
+  InvalidateLayout();
+  DeprecatedLayoutImmediately();
+  StartSeoulOmniboxEntranceAnimation();
+  omnibox->SetFocus(/*is_user_initiated=*/true);
+}
+
+bool BrowserView::IsSeoulOmniboxActionMode() const {
+  return seoul_omnibox_action_mode_ && seoul_omnibox_action_view_;
+}
