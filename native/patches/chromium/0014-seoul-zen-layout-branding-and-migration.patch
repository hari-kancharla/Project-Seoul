 namespace {
 
 // The visible height of the shadow above the tabs. Clicks in this area are
 // treated as clicks to the frame, rather than clicks to the tab.
 const int kTabShadowSize = 2;
 
+seoul::ShellController* GetSeoulShellController(Browser* browser) {
+  if (!browser || !browser->profile()) {
+    return nullptr;
+  }
+  seoul::SeoulOrganizationService* organization =
+      seoul::SeoulOrganizationServiceFactory::GetForProfile(browser->profile());
+  if (!organization || !organization->shell_service()) {
+    return nullptr;
+  }
+  const SessionID session_id = browser->session_id();
+  if (!session_id.is_valid()) {
+    return nullptr;
+  }
+  return organization->shell_service()->GetController(
+      seoul::LiveWindowKey::FromSessionId(session_id.id()));
+}
