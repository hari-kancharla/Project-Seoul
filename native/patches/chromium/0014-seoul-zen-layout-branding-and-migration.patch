+  EXPECT_EQ(24U, keychain_password.GetPassword().size());
+  ASSERT_EQ(1U, keychain.lookups().size());
+  EXPECT_EQ("Seoul Safe Storage", keychain.lookups()[0].first);
+  EXPECT_EQ("Seoul", keychain.lookups()[0].second);
