+int BrowserView::CalculateSeoulOmniboxWidthForTesting(int window_width) {
+  constexpr int kZenFloatingMaximumWidth = 750;
+  return std::min(kZenFloatingMaximumWidth, window_width * 9 / 10);
+}
+
+void BrowserView::UpdateSeoulOmniboxActions(const std::u16string& query) {
+  if (!IsSeoulOmniboxActionMode()) {
+    return;
+  }
+  seoul_omnibox_action_view_->SetQuery(base::UTF16ToUTF8(query));
+  InvalidateLayout();
+  DeprecatedLayoutImmediately();
+}
+
+bool BrowserView::HandleSeoulOmniboxActionKeyEvent(const ui::KeyEvent& event) {
+  if (!IsSeoulOmniboxActionMode() ||
+      event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+
+  const bool control = event.IsControlDown();
+  const bool shift = event.IsShiftDown();
+  const bool alt = event.IsAltDown() || event.IsAltGrDown();
+  const bool command = event.IsCommandDown();
+  switch (event.key_code()) {
+    case ui::VKEY_TAB:
+      return seoul_omnibox_action_view_->MoveSelection(!shift,
+                                                       /*by_page=*/false);
+    case ui::VKEY_UP:
+      if (!shift) {
+        return seoul_omnibox_action_view_->MoveSelection(
+            /*forward=*/false, /*by_page=*/false);
+      }
+      return false;
+    case ui::VKEY_DOWN:
+      if (!shift) {
+        return seoul_omnibox_action_view_->MoveSelection(
+            /*forward=*/true, /*by_page=*/false);
+      }
+      return false;
+    case ui::VKEY_PRIOR:
+      if (!control && !shift && !alt && !command) {
+        return seoul_omnibox_action_view_->MoveSelection(
+            /*forward=*/false, /*by_page=*/true);
+      }
+      return false;
+    case ui::VKEY_NEXT:
+      if (!control && !shift && !alt && !command) {
+        return seoul_omnibox_action_view_->MoveSelection(
+            /*forward=*/true, /*by_page=*/true);
+      }
+      return false;
+    case ui::VKEY_N:
+      if (control && !shift && !alt && !command) {
+        return seoul_omnibox_action_view_->MoveSelection(
+            /*forward=*/true, /*by_page=*/false);
+      }
+      return false;
+    case ui::VKEY_P:
+      if (control && !shift && !alt && !command) {
+        return seoul_omnibox_action_view_->MoveSelection(
+            /*forward=*/false, /*by_page=*/false);
+      }
+      return false;
+    case ui::VKEY_RETURN:
+      if (!control && !alt && !command) {
+        return seoul_omnibox_action_view_->ExecuteSelection();
+      }
+      return false;
+    case ui::VKEY_ESCAPE:
+      HideSeoulOmniboxActions(/*restore_page_focus=*/true);
+      return true;
+    default:
+      return false;
+  }
+}
+
+void BrowserView::HideSeoulOmniboxActions(bool restore_page_focus) {
+  if (!seoul_omnibox_action_mode_) {
+    return;
+  }
+  seoul_omnibox_action_mode_ = false;
+  if (toolbar_ && toolbar_->location_bar_view()) {
+    LocationBarView* location_bar = toolbar_->location_bar_view();
+    location_bar->SetSeoulActionMode(false);
+    location_bar->omnibox_view()->InstallPlaceholderText();
+  }
+  if (seoul_omnibox_action_view_) {
+    RemoveChildViewT(seoul_omnibox_action_view_.get());
+    seoul_omnibox_action_view_ = nullptr;
+  }
+  InvalidateLayout();
+  if (restore_page_focus) {
+    if (views::FocusManager* focus_manager = GetFocusManager()) {
+      focus_manager->ClearFocus();
+    }
+    SetSeoulOmniboxFloating(false);
+    FocusWebContentsPane();
+  }
+}
+
+void BrowserView::ExecuteSeoulOmniboxAction(seoul::CommandLauncherEntry entry) {
+  seoul::ShellController* controller = GetSeoulShellController(browser_.get());
+  if (!controller) {
+    return;
+  }
+  if (controller->ExecuteCommandLauncherEntry(entry).has_value()) {
+    HideSeoulOmniboxActions(/*restore_page_focus=*/true);
+  } else if (seoul_omnibox_action_view_) {
+    // The catalog snapshot may have gone stale. Refresh in place and preserve
+    // the user's query rather than running a different command.
+    UpdateSeoulOmniboxActions(
+        toolbar_->location_bar_view()->omnibox_view()->GetText());
+  }
+}
+
+void BrowserView::RefreshSeoulOmniboxSurfaceBackground() {
+  if (!seoul_omnibox_surface_) {
+    return;
+  }
+  constexpr int kZenRadius = 12;
+  seoul_omnibox_surface_->SetBackground(views::CreateRoundedRectBackground(
+      kColorOmniboxResultsBackground, kZenRadius,
+      /*for_border_thickness=*/1));
+  seoul_omnibox_surface_->SetBorder(
+      views::CreateRoundedRectBorder(1, kZenRadius, kColorLocationBarBorder));
+}
+
+void BrowserView::StartSeoulOmniboxEntranceAnimation() {
+  if (!seoul_omnibox_surface_ || !seoul_omnibox_surface_->layer()) {
+    return;
   }
+  seoul_omnibox_entrance_animation_.reset();
+  seoul_omnibox_surface_->layer()->SetTransform(gfx::Transform());
+  if (gfx::Animation::PrefersReducedMotion()) {
+    return;
+  }
+  seoul_omnibox_entrance_animation_ =
+      std::make_unique<SeoulOmniboxEntranceAnimation>(
+          seoul_omnibox_surface_.get());
+  seoul_omnibox_entrance_animation_->Start();
 }
 
