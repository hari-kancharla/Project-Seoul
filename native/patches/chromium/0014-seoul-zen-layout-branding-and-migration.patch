+void BrowserView::ShowSeoulOmniboxActions() {
+  seoul::ShellController* controller = GetSeoulShellController(browser_.get());
+  if (!controller || !toolbar_ || !toolbar_->location_bar_view()) {
+    return;
+  }
+
+  SetSeoulOmniboxFloating(true);
+  LocationBarView* location_bar = toolbar_->location_bar_view();
+  seoul_omnibox_action_mode_ = true;
+  location_bar->SetSeoulActionMode(true);
