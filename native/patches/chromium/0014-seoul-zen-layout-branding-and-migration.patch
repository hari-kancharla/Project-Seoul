+class SeoulOmniboxEntranceAnimation final : public gfx::LinearAnimation {
+ public:
+  explicit SeoulOmniboxEntranceAnimation(views::View* surface)
+      : gfx::LinearAnimation(base::Milliseconds(150), 60, nullptr),
+        surface_(surface) {}
+
+  SeoulOmniboxEntranceAnimation(const SeoulOmniboxEntranceAnimation&) = delete;
+  SeoulOmniboxEntranceAnimation& operator=(
+      const SeoulOmniboxEntranceAnimation&) = delete;
+  ~SeoulOmniboxEntranceAnimation() override = default;
+
+ protected:
+  void AnimateToState(double state) override {
+    if (!surface_ || !surface_->layer()) {
+      return;
+    }
+    // Firefox/Zen's --animation-easing-function.
+    static const gfx::CubicBezier kZenEasing(0.07, 0.95, 0.0, 1.0);
+    const double value = kZenEasing.Solve(state);
+    const gfx::Rect bounds = surface_->GetLocalBounds();
+    const float center_x = bounds.width() / 2.0f;
+    const float center_y = bounds.height() / 2.0f;
+    gfx::Transform transform;
+    transform.Translate(center_x, center_y);
+    transform.Scale(0.99 + 0.01 * value, 0.98 + 0.02 * value);
+    transform.Translate(-center_x, -center_y);
+    surface_->layer()->SetTransform(transform);
+  }
+
+ private:
+  raw_ptr<views::View> surface_;
+};
