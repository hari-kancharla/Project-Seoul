+bool BrowserLocationBarModelDelegate::ShouldTrimDisplayUrlAfterHostName()
+    const {
+  TabStripModelDelegate* const tab_strip_delegate =
+      tab_strip_model_->delegate();
+  if (!tab_strip_delegate || !tab_strip_delegate->IsNormalWindow()) {
+    return false;
+  }
+
+  auto* const vertical_tabs = tabs::VerticalTabStripStateController::From(
+      tab_strip_delegate->GetBrowserWindowInterface());
+  if (!vertical_tabs || !vertical_tabs->ShouldDisplayVerticalTabs()) {
+    return false;
+  }
+
+  content::WebContents* const web_contents = GetActiveWebContents();
+  Profile* const profile =
+      web_contents
+          ? Profile::FromBrowserContext(web_contents->GetBrowserContext())
+          : nullptr;
+  const PrefService* const prefs = profile ? profile->GetPrefs() : nullptr;
+  return prefs &&
+         prefs->GetBoolean(seoul::kSeoulUrlbarShowDomainOnlyInSidebarPref) &&
+         seoul::GetSeoulLayoutMode(prefs) == seoul::SeoulLayoutMode::kSingle;
+}
