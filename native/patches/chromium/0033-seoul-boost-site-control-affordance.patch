--- /dev/null
+++ b/chrome/app/vector_icons/seoul_boost.icon
@@ -0,0 +1,27 @@
+// Copyright 2026 The Project Seoul Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Paintbrush, for the Boost affordance in the address field. Arc uses a
+// paintbrush for the same action, so the glyph is the one users of that idiom
+// already read as "restyle this site"; the drawing is Seoul's own and matches
+// the 18-DIP, 1.5-stroke rail set.
+//
+// Three parts, so it cannot be misread as a tag: a tapering bristle wedge
+// pointing down-left, a ferrule band across it, and a handle running to the
+// upper right.
+CANVAS_DIMENSIONS, 18,
+STROKE, 1.5,
+MOVE_TO, 6.5, 8.5,
+LINE_TO, 3, 13,
+LINE_TO, 5, 15,
+LINE_TO, 9.5, 11.5,
+CLOSE,
+NEW_PATH,
+STROKE, 1.5,
+MOVE_TO, 7.5, 7.5,
+LINE_TO, 10.5, 10.5,
+NEW_PATH,
+STROKE, 1.5,
+MOVE_TO, 9, 9,
+LINE_TO, 14.5, 3.5,
