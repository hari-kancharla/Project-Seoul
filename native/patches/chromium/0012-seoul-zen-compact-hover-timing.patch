 void VerticalTabStripRegionView::HandleMouseExited() {
+  const bool seoul_integrated_rail =
+      browser_view_ && browser_view_->toolbar() &&
+      browser_view_->toolbar()->parent() == this;
+  if (seoul_integrated_rail && is_expanded_on_hover_) {
+    if (!mouse_exit_timer_.IsRunning()) {
+      mouse_exit_timer_.Start(
+          FROM_HERE, kSeoulCompactModeHideDelay,
+          base::BindOnce(
+              &VerticalTabStripRegionView::UpdateExpandOnHoverState,
+              base::Unretained(this), false));
+    }
+    return;
+  }
+
