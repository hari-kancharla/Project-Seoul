+  // contrast endpoints opaque and preserve an explicitly selected Space accent.
+  const SkColor rail = dark_mode ? SkColorSetRGB(0x0E, 0x19, 0x24)
+                                 : SkColorSetRGB(0xEE, 0xF6, 0xFC);
   const SkColor rail_inactive = rail;
-  const SkColor reverse_brand = dark_mode ? SkColorSetRGB(0xF4, 0xF2, 0xEC)
