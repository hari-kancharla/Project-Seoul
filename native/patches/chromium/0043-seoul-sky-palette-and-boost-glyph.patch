-  const SkColor canvas = dark_mode ? SkColorSetRGB(0x10, 0x0F, 0x0E)
-                                   : SkColorSetRGB(0xEA, 0xE8, 0xE0);
+  const SkColor reverse_brand = dark_mode ? SkColorSetRGB(0xEE, 0xF7, 0xFF)
