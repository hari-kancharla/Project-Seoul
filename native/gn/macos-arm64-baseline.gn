# Seoul native Chromium baseline GN args (macOS arm64).
#
# This file contains ONLY justified local-build settings for a reproducible,
# unmodified Chromium baseline. It contains no Seoul branding, no API keys, no
# proprietary codec flags, no security-disabling flags, no experimental compiler
# options, and no product patches. gen.sh copies these lines verbatim into
# out/SeoulBaseline/args.gn.

# Release build (not a debug build).
is_debug = false

# Component build: faster incremental links and far lower peak link memory than a
# static build. This is the development configuration; release packaging must
# use a separately verified non-component build.
is_component_build = true

# No debug symbols: smaller output, much lower link memory and disk use.
symbol_level = 0

# Development assertions OFF in the build a person actually runs.
#
# `dcheck_always_on` defaults to `(build_with_chromium && !is_official_build)`,
# which is true here, so every DCHECK in Chromium was live in the app. A DCHECK
# is a development aid: upstream writes them to catch invariant violations
# during development, and ships Chrome with them compiled out precisely because
# aborting the whole browser is the wrong response to one in a user's hands.
# Left at the default, an upstream invariant about Chromium's own session-file
# bookkeeping - `CommandStorageBackend::AppendCommands`, reached on a
# BLOCK_SHUTDOWN task - took the browser down with "Seoul quit unexpectedly" on
# exit. Seoul writes no session commands of its own, so this is upstream's
# assertion about upstream's state, and the same code path ships in Chrome with
# the assertion compiled out.
#
# This is a configuration difference between a development build and a product
# build, not a way to hide a defect: the assertion is still worth root-causing,
# and it is recorded as open in docs/release/seoul-product-readiness.md. Build
# with SEOUL_DCHECKS=1 to put them back for development and test runs; CI and
# the native suites are the place for assertions to be loud.
dcheck_always_on = false

# Use the platform linker rather than bundled lld. Kept explicit per the baseline
# spec; revisit only with evidence if linking fails.
use_lld = false

# Target CPU is appended by gen.sh as target_cpu = "arm64" only after the host and
# the pinned revision are confirmed to be Apple Silicon. It is intentionally not
# hard-coded here so the file documents the gating decision.
