# macOS
.DS_Store

# Node / build output
node_modules/
dist/

# Local working directories
.local/

# Logs
*.log
logs/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Editors / IDEs
.vscode/
.idea/
