# macOS
.DS_Store

# Node / build output
node_modules/
dist/

# Local working directories
.local/

# Logs
*.log
logs/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Editors / IDEs
.vscode/
.idea/
*.swp

# local probe scripts
_probe_*.mjs

# Verification evidence (screenshots, raw logs) - never committed.
#
# The root-level rule is here because 19 MB of seoul-ui-verify-*.png got swept
# into a commit about Package.swift and sat in the tree unreferenced. The
# verifiers write these to /tmp by design; nothing in the repo reads one.
native/evidence/
seoul-ui-verify*.png
seoul-verify-*.png

# Verification captures dropped in the working directory. Product artwork lives
# under native/seoul/resources/; a bare image at the root is always scratch, and
# check-repo-boundary.mjs fails the build if one is tracked anyway.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.mov
/*.mp4

# Safety: never track an in-repo Chromium checkout or build output
seoul-chromium/
seoul-chromium.noindex/
native/**/out/
apps/voice-lab/runtime/
apps/voice-lab/models/
apps/voice-lab/out/
apps/voice-lab/recordings/

# Swift package build output and generated Xcode projects
.build/
*.xcodeproj
*.xcworkspace

# Signed component artifacts and key material never belong in the repo.
*.crx
*.pem
*.der

# Ad-hoc UI verification screenshots belong in the scratchpad, not the repo.
seoul-ui-verify-*.png
